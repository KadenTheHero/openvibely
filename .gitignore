# macOS filesystem metadata
.DS_Store

# Runtime-generated artifacts (attachments, managed repos, local app state)
uploads/
repos/
.worktrees/
logs/

# Local OpenVibely runtime state. Project memory can be versioned per repo by
# committing root .openvibely/memories/*.md files. Nested runtime state, caches,
# and logs remain ignored.
**/.openvibely/
!/.openvibely/
/.openvibely/*
!/.openvibely/memory/
/.openvibely/memory/*
!/.openvibely/memory/*.md
!/.openvibely/memories/
/.openvibely/memories/*
!/.openvibely/memories/*.md
!/.openvibely/skills/
/.openvibely/skills/*
!/.openvibely/skills/SKILLS.md
!/.openvibely/skills/openvibely_project_guidance/
/.openvibely/skills/openvibely_project_guidance/*
!/.openvibely/skills/openvibely_project_guidance/SKILL.md

# Local SQLite runtime files
openvibely.db
openvibely.db-shm
openvibely.db-wal

# Local build/test binaries
bin/
/server
*.test

# Local environment overrides
.env
.env.local
.env.*.local
