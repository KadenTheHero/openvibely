		<style>
			/* Prevent password toggle button from moving on click */
			.password-toggle-btn:active {
				transform: translate(0.25rem, -50%) !important;
			}
		</style>

			<script>
					function launchOAuthInSystemBrowser(path) {
						var href = path || '';
						if (!href) return false;
						var externalURL = href;
						if (externalURL.indexOf('?') === -1) {
							externalURL += '?external=1';
						} else if (externalURL.indexOf('external=') === -1) {
							externalURL += '&external=1';
						}
						fetch(externalURL, {
							method: 'GET',
							headers: {
								'X-Requested-With': 'XMLHttpRequest'
							}
						}).then(function(resp) {
							if (!resp.ok) {
								throw new Error('Failed to open OAuth in browser');
							}
							if (window.showToast) window.showToast('Opened browser for OAuth', 'completed');
						}).catch(function(err) {
							if (window.showToast) window.showToast(err.message || 'Failed to open OAuth in browser', 'failed');
						});
						return false;
					}

					function togglePasswordVisibility(inputId, button) {
					const input = document.getElementById(inputId);
					const eyeOpen = button.querySelector('.eye-open');
					const eyeClosed = button.querySelector('.eye-closed');
					
					if (input.type === 'password') {
						input.type = 'text';
						eyeOpen.classList.add('hidden');
						eyeClosed.classList.remove('hidden');
					} else {
						input.type = 'password';
						eyeOpen.classList.remove('hidden');
						eyeClosed.classList.add('hidden');
					}
				}

				function submitOAuthManualComplete() {
					var input = document.getElementById('oauth_manual_callback_url');
					if (!input) return;
					var callbackUrl = (input.value || '').trim();
					if (!callbackUrl) {
						if (window.showToast) window.showToast('Paste a localhost callback URL first', 'failed');
						return;
					}

					fetch('/models/oauth/manual-complete', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'HX-Request': 'true'
						},
						body: JSON.stringify({ callback_url: callbackUrl })
					}).then(function(resp) {
						if (!resp.ok) {
							return resp.json().then(function(data) {
								throw new Error((data && data.error) || 'OAuth completion failed');
							}).catch(function() {
								throw new Error('OAuth completion failed');
							});
						}
						return resp.json();
					}).then(function() {
						if (window.showToast) window.showToast('OAuth connected', 'completed');
						input.value = '';
						window.location.reload();
					}).catch(function(err) {
						if (window.showToast) window.showToast(err.message || 'OAuth completion failed', 'failed');
					});
				}

				var reasoningEffortOptions = {
					low: 'Low',
					medium: 'Medium',
					high: 'High',
					xhigh: 'XHigh',
					max: 'Max'
				};
			var modelOptionsByProvider = {
					anthropic: [
						{ value: 'claude-sonnet-4-6', label: 'Claude Sonnet 4.6', efforts: ['low', 'medium', 'high', 'max'] },
