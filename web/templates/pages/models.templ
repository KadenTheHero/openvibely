							<div id="openai_compatible_fields" class="hidden">
								<input type="hidden" id="model_openai_compatible_preset" name="preset_slug" value="custom"/>
								<input type="hidden" id="model_openai_compatible_transport" name="transport" value="chat_completions"/>							<div class="form-control mb-3">
