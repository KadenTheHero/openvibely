						<div id="api_key_field" class="form-control mb-3">						<label class="label"><span class="label-text">API Key</span></label>
						<div class="relative">
							<input type="password" id="model_api_key" name="api_key" class="input input-bordered pr-10" placeholder="sk-ant-... (leave empty to keep existing)" oninput="scheduleAutoDiscoverOpenAICompatibleModels()"/>
							<button
								type="button"
								class="password-toggle-btn btn btn-ghost btn-sm absolute right-1 top-1/2 -translate-y-1/2 h-8 min-h-0 px-2"
								onclick="togglePasswordVisibility('model_api_key', this)"
								tabindex="-1"
								aria-label="Toggle API key visibility"
							>
