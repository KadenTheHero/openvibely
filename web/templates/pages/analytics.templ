package pages

import (
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Analytics(projects []models.Project, currentProject *models.Project) {
	@layout.Base("Analytics Dashboard", projects, projectID(currentProject)) {
		@analyticsContent(currentProject)
	}
}

// AnalyticsContent renders just the analytics content for HTMX requests
templ AnalyticsContent(currentProject *models.Project) {
	@analyticsContent(currentProject)
}

templ analyticsContent(currentProject *models.Project) {
	<div class="flex justify-between items-center mb-6">
			<h2 class="text-2xl font-bold">Analytics Dashboard</h2>
			if currentProject != nil {
				<div class="flex gap-2 items-center">
					<span class="opacity-60">Project:</span>
					<span class="font-semibold">{ currentProject.Name }</span>
				</div>
			}
		</div>
		if currentProject != nil {
			<!-- Filters -->
			<div class="card bg-base-100 shadow-sm border border-base-300 mb-6">
				<div class="card-body p-4">
					<div class="flex flex-wrap gap-4 items-end">
						<div class="form-control">
							<label class="label"><span class="label-text">Date Range</span></label>
							<select id="dateRange" class="select select-bordered select-sm">
								<option value="7">Last 7 Days</option>
								<option value="30" selected>Last 30 Days</option>
								<option value="90">Last 90 Days</option>
								<option value="365">Last Year</option>
								<option value="all">All Time</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text">Group By</span></label>
							<select id="groupBy" class="select select-bordered select-sm">
								<option value="day" selected>Day</option>
								<option value="week">Week</option>
								<option value="month">Month</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text">Skill Surface</span></label>
							<select id="skillSurfaceFilter" class="select select-bordered select-sm">
								<option value="">All surfaces</option>
								<option value="chat">Chat</option>
								<option value="task_thread">Task thread</option>
								<option value="scheduled_task">Scheduled task</option>
								<option value="lifecycle_hook">Lifecycle hook</option>
								<option value="channel">Channel</option>
								<option value="goal_continuation">Goal continuation</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text">Skill Scope</span></label>
							<select id="skillScopeFilter" class="select select-bordered select-sm">
								<option value="">All scopes</option>
								<option value="project">Project</option>
								<option value="global">Global</option>
								<option value="agent_owned">Agent-owned</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text">Skill Event</span></label>
							<select id="skillEventFilter" class="select select-bordered select-sm">
								<option value="">All events</option>
								<option value="selected">Selected</option>
								<option value="loaded">Loaded</option>
								<option value="viewed">Viewed</option>
								<option value="edited">Edited</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text">Agent ID</span></label>
							<input id="skillAgentFilter" class="input input-bordered input-sm w-44" placeholder="All agents" />
						</div>
						<button id="refreshBtn" class="btn btn-primary btn-sm">Refresh</button>
					</div>
				</div>
			</div>

				<!-- Skill Curator Analytics -->
				<div class="card bg-base-100 shadow-sm border border-base-300 mb-6">
					<div class="card-body">
						<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
							<div>
								<h3 class="card-title text-lg">Skill Curator Analytics</h3>
								<p class="text-sm opacity-60">Track selected, loaded, viewed, and edited skill activity.</p>
							</div>
							<div class="tabs tabs-boxed bg-base-200" role="tablist" aria-label="Skill analytics views">
								<button type="button" class="tab tab-active" data-skill-panel="top" role="tab" aria-selected="true">Overview</button>
								<button type="button" class="tab" data-skill-panel="follow" role="tab" aria-selected="false">Follow-through</button>
								<button type="button" class="tab" data-skill-panel="agents" role="tab" aria-selected="false">Agents</button>
								<button type="button" class="tab" data-skill-panel="underused" role="tab" aria-selected="false">Underused</button>
							</div>
						</div>

						<div class="skill-analytics-panel" data-skill-panel-content="top">
							<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
								<div class="h-64">
									<canvas id="skillTopChart"></canvas>
								</div>
								<div>
									<h4 class="font-semibold mb-2">Top Skill Details</h4>
									<div class="overflow-x-auto max-h-64">
										<table class="table table-sm">
											<thead><tr><th>Skill</th><th>S</th><th>L</th><th>V</th><th>E</th><th>Follow</th></tr></thead>
											<tbody id="skillTopTable"><tr><td colspan="6" class="text-center opacity-50">No skill events yet</td></tr></tbody>
										</table>
									</div>
								</div>
							</div>
						</div>

						<div class="skill-analytics-panel hidden" data-skill-panel-content="follow">
							<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
								<div class="h-64">
									<canvas id="skillFollowChart"></canvas>
								</div>
								<div>
									<h4 class="font-semibold mb-2">Selection Outcomes</h4>
									<div class="overflow-x-auto max-h-64">
										<table class="table table-sm">
											<thead><tr><th>Skill</th><th>Selected</th><th>Used</th><th>Ignored</th><th>Rate</th></tr></thead>
											<tbody id="skillFollowTable"><tr><td colspan="5" class="text-center opacity-50">No selected skills yet</td></tr></tbody>
										</table>
									</div>
								</div>
							</div>
						</div>

						<div class="skill-analytics-panel hidden" data-skill-panel-content="agents">
							<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
								<div class="h-64">
									<canvas id="skillAgentChart"></canvas>
								</div>
								<div>
									<h4 class="font-semibold mb-2">Top Agent/Skill Pairs</h4>
									<div class="overflow-x-auto max-h-64">
										<table class="table table-sm">
											<thead><tr><th>Agent</th><th>Skill</th><th>Activity</th><th>S</th><th>L</th><th>V</th></tr></thead>
											<tbody id="skillAgentTable"><tr><td colspan="6" class="text-center opacity-50">No agent skill activity yet</td></tr></tbody>
										</table>
									</div>
								</div>
							</div>
						</div>

						<div class="skill-analytics-panel hidden" data-skill-panel-content="underused">
							<div class="overflow-x-auto max-h-96">
								<table class="table table-sm">
									<thead><tr><th>Skill</th><th>Scope</th><th>Always-use</th><th>S</th><th>L</th><th>V</th><th>Last activity</th></tr></thead>
									<tbody id="underusedSkillsTable"><tr><td colspan="7" class="text-center opacity-50">No enabled skills found</td></tr></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
				<!-- Provider Account Cards -->
				<div id="accountUsageCards" class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<p class="opacity-50 lg:col-span-2">No connected OAuth account snapshots yet.</p>
				</div>
				<!-- Usage Charts -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="flex flex-wrap items-end justify-between gap-3 mb-2">
								<h3 class="card-title text-lg">Token Usage</h3>
								<div class="form-control">
									<select id="usageRateModelSelect" class="select select-bordered select-xs min-w-48"></select>
								</div>
							</div>
							<div class="h-64"><canvas id="usageRateChart"></canvas></div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Model Breakdown by Tokens</h3>
							<div class="h-64">
								<canvas id="modelTokenBreakdownChart"></canvas>
							</div>
						</div>
					</div>
				</div>
				<!-- Token Usage Tracking -->
				<div class="card bg-base-100 shadow-sm border border-base-300 mb-6 self-start h-fit">
					<div class="card-body">
						<div class="flex items-center justify-between gap-3 mb-2">
							<h3 class="card-title text-lg">Token Usage Breakdown</h3>
							<span id="usageLastUpdated" class="text-xs opacity-60">Usage loading…</span>
						</div>
						<div class="overflow-x-auto">
							<table class="table table-sm">
								<thead><tr><th>Provider</th><th>Model</th><th>Input</th><th>Output</th><th>Cache</th><th>Reasoning</th><th>Total</th><th>Cost</th></tr></thead>
								<tbody id="usageBreakdownTable"><tr><td colspan="8" class="text-center opacity-50">No usage recorded yet</td></tr></tbody>
							</table>
						</div>
					</div>
				</div>
				<!-- Charts Grid -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">				<!-- Success/Failure Rates -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Success/Failure Rates Over Time</h3>
						<div class="h-64">
							<canvas id="successFailureChart"></canvas>
						</div>
					</div>
				</div>
				<!-- Execution Trends by Hour -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Task Execution by Hour</h3>
						<div class="h-64">
							<canvas id="hourlyTrendsChart"></canvas>
						</div>
					</div>
				</div>
				<!-- Average Execution Time by Task -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Average Execution Time by Task</h3>
						<div class="h-64">
							<canvas id="avgTimeTaskChart"></canvas>
						</div>
					</div>
				</div>
					<!-- Average Execution Time by Model -->
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Average Execution Time by Model</h3>
							<div class="h-64">
								<canvas id="avgTimeAgentChart"></canvas>
							</div>
						</div>
					</div>
					<!-- Model Breakdown by Executions -->
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Model Breakdown by Executions</h3>
							<div class="h-64">
								<canvas id="agentUsageChart"></canvas>
							</div>
						</div>
					</div>
					<!-- Most Frequent Tasks -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Most Frequently Run Tasks</h3>
						<div class="h-64 overflow-y-auto" id="frequentTasksList"></div>
					</div>
				</div>
			</div>
			<!-- Failed Task Patterns -->
			<div class="card bg-base-100 shadow-sm border border-base-300 mt-6">
				<div class="card-body">
					<h3 class="card-title text-lg">Failed Task Patterns</h3>
					<div class="overflow-x-auto">
						<table class="table table-sm" id="failedPatternsTable">
							<thead>
								<tr>
									<th>Task</th>
									<th>Failure Count</th>
									<th>Last Error</th>
									<th>Last Failed At</th>
								</tr>
							</thead>
							<tbody></tbody>
						</table>
					</div>
				</div>
			</div>
			<!-- Chart.js and Custom Script -->
			<div id="analytics-data" data-project-id={ currentProject.ID } class="hidden"></div>
			<script type="text/javascript">
				(function() {
				// Destroy any charts from a previous analytics page visit
				if (window._analyticsCharts) {
					Object.values(window._analyticsCharts).forEach(function(c) {
						try { c.destroy(); } catch(e) {}
					});
				}
				window._analyticsCharts = {};

				function initAnalytics() {
					var dataEl = document.getElementById('analytics-data');
					if (!dataEl) return;
					var projectID = dataEl.dataset.projectId;
					var charts = window._analyticsCharts;
					var latestUsageAnalytics = null;

					// Helper to safely fetch JSON arrays from API
					async function fetchJSON(url) {
						const response = await fetch(url);
						if (!response.ok) return [];
						const data = await response.json();
						return Array.isArray(data) ? data : [];
					}

						function formatNumber(value) {
							return new Intl.NumberFormat().format(value || 0);
						}

						function formatCost(value) {
							if (value === null || value === undefined) return 'cost unavailable';
							return '$' + Number(value).toFixed(4);
						}

						function formatResetCountdown(value) {
							if (!value) return '';
							const resetAt = new Date(value);
							if (Number.isNaN(resetAt.getTime())) return '';
							const totalMinutes = Math.max(0, Math.ceil((resetAt.getTime() - Date.now()) / 60000));
							const days = Math.floor(totalMinutes / 1440);
							const hours = Math.floor((totalMinutes % 1440) / 60);
							const minutes = totalMinutes % 60;
							const parts = [];
							if (days > 0) parts.push(days + ' ' + (days === 1 ? 'day' : 'days'));
							if (hours > 0) parts.push(hours + ' ' + (hours === 1 ? 'hour' : 'hours'));
							if (minutes > 0 || parts.length === 0) parts.push(minutes + ' ' + (minutes === 1 ? 'minute' : 'minutes'));
							return 'Resets: ' + parts.join(', ');
						}


								function usageModelKey(row) {
									return JSON.stringify([row.provider || 'unknown', row.model || 'unknown']);
								}

								function usageModelParts(rowOrKey) {
									if (typeof rowOrKey !== 'string') return [rowOrKey.provider || 'unknown', rowOrKey.model || 'unknown'];
									try {
										const parts = JSON.parse(rowOrKey);
										if (Array.isArray(parts) && parts.length >= 2) return [parts[0] || 'unknown', parts[1] || 'unknown'];
									} catch (e) {}
									const fallback = rowOrKey.split('/');
									return [fallback[0] || 'unknown', fallback.slice(1).join('/') || 'unknown'];
								}

								function usageModelLabel(rowOrKey) {
									const parts = usageModelParts(rowOrKey);
									return parts[0] + '/' + parts[1];
								}

								function escapeHTML(value) {
									return String(value).replace(/[&<>"']/g, function(ch) {
										return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
									});
								}


								function relativeTime(value) {
									if (!value) return 'never';
									const date = new Date(value);
									if (Number.isNaN(date.getTime())) return 'never';
									const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
									if (seconds < 60) return 'today';
									const minutes = Math.floor(seconds / 60);
									if (minutes < 60) return minutes + 'm ago';
									const hours = Math.floor(minutes / 60);
									if (hours < 24) return hours + 'h ago';
									const days = Math.floor(hours / 24);
									return days + 'd ago';
								}

								function skillRangeParam() { return usageRangeParam(); }

								async function loadSkillAnalytics() {
									try {
										const params = new URLSearchParams({ project_id: projectID, range: skillRangeParam() });
										const surface = document.getElementById('skillSurfaceFilter')?.value || '';
										const scope = document.getElementById('skillScopeFilter')?.value || '';
										const eventType = document.getElementById('skillEventFilter')?.value || '';
										const agentID = (document.getElementById('skillAgentFilter')?.value || '').trim();
										if (surface) params.append('surface', surface);
										if (scope) params.append('skill_scope', scope);
										if (eventType) params.append('event_type', eventType);
										if (agentID) params.append('agent_id', agentID);
										const response = await fetch('/api/analytics/skills?' + params.toString());
										if (!response.ok) return;
										renderSkillAnalytics(await response.json());
									} catch (e) { console.error('loadSkillAnalytics:', e); }
								}

								function setSkillAnalyticsPanel(panel) {
									document.querySelectorAll('[data-skill-panel]').forEach(function(tab) {
										const active = tab.dataset.skillPanel === panel;
										tab.classList.toggle('tab-active', active);
										tab.setAttribute('aria-selected', active ? 'true' : 'false');
									});
									document.querySelectorAll('[data-skill-panel-content]').forEach(function(content) {
										content.classList.toggle('hidden', content.dataset.skillPanelContent !== panel);
									});
									Object.values(charts).forEach(function(chart) {
										try { chart.resize(); } catch (e) {}
									});
								}

								function renderSkillAnalytics(data) {
									renderSkillTop(data?.top_skills || []);
									renderSkillFollow(data?.follow_through || []);
									renderSkillAgentUsage(data?.agent_usage || {});
									renderUnderusedSkills(data?.underused || []);
								}

								function skillLabel(value) {
									const text = String(value || 'unknown');
									return text.length > 34 ? text.slice(0, 31) + '…' : text;
								}

								function skillEventTotals(rows) {
									return (rows || []).reduce(function(acc, row) {
										acc.selected += row.selected_count || 0;
										acc.loaded += row.loaded_count || 0;
										acc.viewed += row.viewed_count || 0;
										acc.edited += row.edited_count || 0;
										return acc;
									}, { selected: 0, loaded: 0, viewed: 0, edited: 0 });
								}

								function renderSkillTop(rows) {
									if (charts.skillTop) charts.skillTop.destroy();
									const canvas = document.getElementById('skillTopChart');
									if (canvas) {
										const totals = skillEventTotals(rows);
							const totalEvents = totals.selected + totals.loaded + totals.viewed + totals.edited;
										charts.skillTop = new Chart(canvas.getContext('2d'), {
											type: 'pie',
											data: {
												labels: totalEvents === 0 ? ['No skill events'] : ['Selected', 'Loaded', 'Viewed', 'Edited'],
												datasets: [{
													data: totalEvents === 0 ? [1] : [totals.selected, totals.loaded, totals.viewed, totals.edited],
													backgroundColor: totalEvents === 0 ? ['rgba(148, 163, 184, 0.35)'] : [
														'rgba(59, 130, 246, 0.7)',
														'rgba(34, 197, 94, 0.7)',
														'rgba(251, 146, 60, 0.7)',
														'rgba(147, 51, 234, 0.7)'
													]
												}]
											},
											options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
										});
									}
									const tbody = document.getElementById('skillTopTable');
									if (!tbody) return;
									if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="6" class="text-center opacity-50">No skill events yet</td></tr>'; return; }
									tbody.innerHTML = rows.slice(0, 8).map(r => '<tr><td><code>' + escapeHTML(r.skill_handle) + '</code></td><td>' + formatNumber(r.selected_count) + '</td><td>' + formatNumber(r.loaded_count) + '</td><td>' + formatNumber(r.viewed_count) + '</td><td>' + formatNumber(r.edited_count) + '</td><td>' + (r.follow_through_rate === null || r.follow_through_rate === undefined ? '-' : Math.round(Number(r.follow_through_rate) * 100) + '%') + '</td></tr>').join('');
								}

								function renderSkillFollow(rows) {
									if (charts.skillFollow) charts.skillFollow.destroy();
									const canvas = document.getElementById('skillFollowChart');
									if (canvas) {
										charts.skillFollow = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: { labels: rows.slice(0, 8).map(r => skillLabel(r.skill_handle)), datasets: [
												{ label: 'Used', data: rows.slice(0, 8).map(r => r.loaded_or_viewed_count || 0), backgroundColor: 'rgba(34, 197, 94, 0.5)', borderColor: 'rgb(34, 197, 94)', borderWidth: 1 },
												{ label: 'Ignored', data: rows.slice(0, 8).map(r => r.ignored_count || 0), backgroundColor: 'rgba(239, 68, 68, 0.5)', borderColor: 'rgb(239, 68, 68)', borderWidth: 1 }
											] },
											options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true, stacked: true }, y: { stacked: true } }, plugins: { legend: { position: 'bottom' } } }
										});
									}
									const tbody = document.getElementById('skillFollowTable');
									if (!tbody) return;
									if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="5" class="text-center opacity-50">No selected skills yet</td></tr>'; return; }
									tbody.innerHTML = rows.slice(0, 8).map(r => '<tr><td><code>' + escapeHTML(r.skill_handle) + '</code></td><td>' + formatNumber(r.selected_count) + '</td><td>' + formatNumber(r.loaded_or_viewed_count) + '</td><td>' + formatNumber(r.ignored_count) + '</td><td>' + (r.follow_through_rate === null || r.follow_through_rate === undefined ? '-' : Math.round(Number(r.follow_through_rate) * 100) + '%') + '</td></tr>').join('');
								}

								function renderSkillAgentUsage(heatmap) {
									if (charts.skillAgent) charts.skillAgent.destroy();
									const canvas = document.getElementById('skillAgentChart');
									const cells = heatmap.cells || [];
									const agentNames = new Map((heatmap.agents || []).map(a => [a.agent_id || '', a.agent_name || a.agent_id || 'Unassigned']));
									const rows = cells.map(function(cell) {
										return Object.assign({}, cell, {
											agent_name: agentNames.get(cell.agent_id || '') || 'Unassigned',
											activity: (cell.selected_count || 0) + (cell.loaded_count || 0) + (cell.viewed_count || 0)
										});
									}).filter(row => row.activity > 0).sort((a, b) => b.activity - a.activity).slice(0, 8);
									if (canvas) {
										charts.skillAgent = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: {
												labels: rows.map(row => skillLabel(row.agent_name + ' · ' + row.skill_handle)),
												datasets: [{ label: 'Activity', data: rows.map(row => row.activity), backgroundColor: 'rgba(20, 184, 166, 0.5)', borderColor: 'rgb(20, 184, 166)', borderWidth: 1 }]
											},
											options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true } }, plugins: { legend: { position: 'bottom' } } }
										});
									}
									const tbody = document.getElementById('skillAgentTable');
									if (!tbody) return;
									if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="6" class="text-center opacity-50">No agent skill activity yet</td></tr>'; return; }
									tbody.innerHTML = rows.map(row => '<tr><td>' + escapeHTML(row.agent_name) + '</td><td><code>' + escapeHTML(row.skill_handle) + '</code></td><td>' + formatNumber(row.activity) + '</td><td>' + formatNumber(row.selected_count) + '</td><td>' + formatNumber(row.loaded_count) + '</td><td>' + formatNumber(row.viewed_count) + '</td></tr>').join('');
								}

								function renderUnderusedSkills(rows) {
									const tbody = document.getElementById('underusedSkillsTable');
									if (!tbody) return;
									if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="7" class="text-center opacity-50">No enabled skills found</td></tr>'; return; }
									tbody.innerHTML = rows.map(r => '<tr><td><code>' + escapeHTML(r.skill_handle) + '</code></td><td><span class="badge badge-ghost badge-sm">' + escapeHTML(r.skill_scope || '') + '</span></td><td>' + (r.always_use ? 'yes' : 'no') + '</td><td>' + formatNumber(r.selected_count) + '</td><td>' + formatNumber(r.loaded_count) + '</td><td>' + formatNumber(r.viewed_count) + '</td><td class="text-xs opacity-70">' + relativeTime(r.last_activity) + '</td></tr>').join('');
								}

								function modelSeriesKeys(rows) {
									return Array.from(new Set((rows || []).map(usageModelKey))).sort(function(a, b) { return usageModelLabel(a).localeCompare(usageModelLabel(b)); });
								}

								function fillModelChoiceSelect(selectID, keys) {
									const select = document.getElementById(selectID);
									if (!select) return 'combined';
									const previous = select.value || 'combined';
									const validChoices = ['combined', 'all'].concat(keys || []);
									const keep = validChoices.includes(previous) ? previous : 'combined';
									const modelOptions = (keys || []).map(key => '<option value="' + escapeHTML(key) + '">' + escapeHTML(usageModelLabel(key)) + '</option>').join('');
									select.innerHTML = '<option value="combined">All models combined</option><option value="all">Each model</option>' + modelOptions;
									select.value = keep;
									select.disabled = (keys || []).length === 0;
									return keep;
								}

							const usageSeriesColors = [
								'rgb(59, 130, 246)',
								'rgb(34, 197, 94)',
								'rgb(251, 146, 60)',
								'rgb(147, 51, 234)',
								'rgb(239, 68, 68)',
								'rgb(20, 184, 166)',
								'rgb(236, 72, 153)',
								'rgb(132, 204, 22)'
							];

							function colorForIndex(index, alpha) {
								const color = usageSeriesColors[index % usageSeriesColors.length];
								return color.replace('rgb(', 'rgba(').replace(')', ', ' + alpha + ')');
							}

							function uniquePeriods(rows) {
								return Array.from(new Set((rows || []).map(row => row.period))).sort();
							}
							function usageRangeParam() {
							const range = document.getElementById('dateRange').value;
							if (range === '7') return '7d';
							if (range === '90') return '90d';
							if (range === '365') return '365d';
							if (range === 'all') return 'all';
							return '30d';
						}
						// Format milliseconds as human-readable duration (e.g., "5m 30s", "2h 15m")
					function formatDuration(ms) {
						if (ms < 1000) return ms.toFixed(0) + 'ms';
						var totalSeconds = Math.round(ms / 1000);
						var hours = Math.floor(totalSeconds / 3600);
						var minutes = Math.floor((totalSeconds % 3600) / 60);
						var seconds = totalSeconds % 60;
						if (hours > 0) return hours + 'h ' + minutes + 'm';
						if (minutes > 0) return minutes + 'm ' + seconds + 's';
						return seconds + 's';
					}

					// Utility function to get date range
					function getDateRange() {
						const range = document.getElementById('dateRange').value;
						if (range === 'all') {
							return { dateFrom: '', dateTo: '' };
						}
						const dateTo = new Date();
						const dateFrom = new Date();
						dateFrom.setDate(dateTo.getDate() - parseInt(range));
						return {
							dateFrom: dateFrom.toISOString(),
							dateTo: dateTo.toISOString()
						};
					}

								function renderUsageRateChart(data) {
									const rate = data?.usage_rate || [];
									const rateByModel = data?.usage_rate_by_model || [];
									const rateKeys = modelSeriesKeys(rateByModel);
									const choice = fillModelChoiceSelect('usageRateModelSelect', rateKeys);
									if (charts.usageRate) charts.usageRate.destroy();
									const rateCtx = document.getElementById('usageRateChart');
									if (!rateCtx) return;
									let labels = [];
									let datasets = [];
									if (choice === 'combined' || rateByModel.length === 0) {
										labels = rate.map(d => d.period);
										datasets = [{ label: 'All models', data: rate.map(d => d.total_tokens || 0), borderColor: 'rgb(147, 51, 234)', backgroundColor: 'rgba(147, 51, 234, 0.12)', tension: 0.25 }];
									} else {
										const rows = choice === 'all' ? rateByModel : rateByModel.filter(row => usageModelKey(row) === choice);
										labels = uniquePeriods(rows);
										const keys = choice === 'all' ? rateKeys : (choice ? [choice] : []);
										datasets = keys.map((key, index) => {
											const totalsByPeriod = new Map(rows.filter(row => usageModelKey(row) === key).map(row => [row.period, row.total_tokens || 0]));
											return { label: usageModelLabel(key), data: labels.map(period => totalsByPeriod.get(period) || 0), borderColor: usageSeriesColors[index % usageSeriesColors.length], backgroundColor: colorForIndex(index, 0.12), tension: 0.25 };
										});
									}
									charts.usageRate = new Chart(rateCtx.getContext('2d'), {
										type: 'line',
										data: { labels: labels, datasets: datasets },
										options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'bottom' } }, scales: { y: { beginAtZero: true } } }
									});
								}

								function renderUsageAnalytics(data) {
									const totals = data.totals || {};
									const lastUpdated = document.getElementById('usageLastUpdated');
									lastUpdated.textContent = data.last_updated_at ? 'Last updated ' + new Date(data.last_updated_at).toLocaleString() : 'Local usage history';
										renderUsageRateChart(data);

									const breakdown = data.model_breakdown || [];
									const table = document.getElementById('usageBreakdownTable');
									if (table) {
										if (breakdown.length === 0 && (totals.call_count || 0) === 0) {
											table.innerHTML = '<tr><td colspan="8" class="text-center opacity-50">No usage recorded yet</td></tr>';
										} else {
											const rows = breakdown.map(row => '<tr><td>' + escapeHTML(row.provider || 'unknown') + '</td><td>' + escapeHTML(row.model || 'unknown') + '</td><td>' + formatNumber(row.input_tokens) + '</td><td>' + formatNumber(row.output_tokens) + '</td><td>' + formatNumber(row.cached_input_tokens) + '</td><td>' + formatNumber(row.reasoning_output_tokens) + '</td><td>' + formatNumber(row.total_tokens) + '</td><td>' + formatCost(row.cost_usd) + '</td></tr>');
											const totalCost = totals.cost_available ? formatCost(totals.cost_usd) : 'cost unavailable';
											rows.push('<tr class="font-semibold border-t border-base-300"><td>Total</td><td>All models</td><td>' + formatNumber(totals.input_tokens) + '</td><td>' + formatNumber(totals.output_tokens) + '</td><td>' + formatNumber(totals.cached_input_tokens) + '</td><td>' + formatNumber(totals.reasoning_output_tokens) + '</td><td>' + formatNumber(totals.total_tokens) + '</td><td>' + totalCost + '</td></tr>');
											table.innerHTML = rows.join('');
										}
									}
									if (charts.modelTokenBreakdown) charts.modelTokenBreakdown.destroy();
									const modelCtx = document.getElementById('modelTokenBreakdownChart');
									if (modelCtx) {
										charts.modelTokenBreakdown = new Chart(modelCtx.getContext('2d'), {
											type: 'pie',
											data: {
												labels: breakdown.map(row => `${row.provider}/${row.model}`),
												datasets: [{
													data: breakdown.map(row => row.total_tokens || 0),
													backgroundColor: [
														'rgba(239, 68, 68, 0.7)',
														'rgba(34, 197, 94, 0.7)',
														'rgba(59, 130, 246, 0.7)',
														'rgba(251, 146, 60, 0.7)',
														'rgba(147, 51, 234, 0.7)',
														'rgba(20, 184, 166, 0.7)'
													]
												}]
											},
											options: {
												responsive: true,
												maintainAspectRatio: false,
												plugins: { legend: { position: 'bottom' } }
											}
										});
									}
									const accountContainer = document.getElementById('accountUsageCards');
									const accounts = data.account_limits || [];
									if (accountContainer) {
										if (accounts.length === 0) {
											accountContainer.innerHTML = '<p class="opacity-50 lg:col-span-2">No connected OAuth account snapshots yet.</p>';
										} else {
											accountContainer.innerHTML = accounts.map(account => {
												let accountLimits = [];
												if (account.primary_limit) accountLimits.push(account.primary_limit);
												if (account.secondary_limit) accountLimits.push(account.secondary_limit);
												accountLimits = accountLimits.concat(account.extra_limits || []);
												if (accountLimits.length === 0) accountLimits = account.limits || [];
												const limits = accountLimits.map(limit => {
													const pct = limit.used_percent === null || limit.used_percent === undefined ? null : Number(limit.used_percent);
													const width = pct === null ? 0 : Math.max(0, Math.min(100, pct));
													const resetLabel = formatResetCountdown(limit.resets_at);
													const reset = resetLabel ? `<div class="text-xs opacity-60">${resetLabel}</div>` : '';
													return `<div class="mt-2"><div class="flex justify-between text-xs"><span>${escapeHTML(limit.label || 'limit')}</span><span>${pct === null ? 'unknown' : pct.toFixed(1) + '%'}</span></div><div class="ov-account-limit-bar" role="meter" aria-label="${escapeHTML(limit.label || 'limit')} usage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${width.toFixed(1)}"><div class="ov-account-limit-bar-fill" style="width: ${width}%"></div></div>${reset}</div>`;
												}).join('');
												const error = account.error ? `<div class="alert alert-warning py-2 text-xs mt-2">${escapeHTML(account.error)}</div>` : '';
												const providerName = (account.provider || '').toLowerCase();
												const providerTitle = providerName === 'openai' ? 'OpenAI' : (providerName === 'anthropic' ? 'Anthropic' : 'OAuth account');
												const subscription = account.plan_type || '';
												const metaParts = providerName === 'anthropic' ? [account.extra_usage_label] : [account.status_label, account.billing_label, account.extra_usage_label];
												const meta = metaParts.filter(Boolean).join(' · ');
												const detail = providerName === 'anthropic' ? '' : (account.account_detail || '');
												const usedCredits = account.extra_usage_used_usd !== null && account.extra_usage_used_usd !== undefined ? ' · Used: $' + Number(account.extra_usage_used_usd).toFixed(2) : '';
												const extraUsage = account.extra_usage_monthly_usd !== null && account.extra_usage_monthly_usd !== undefined ? '<div class="text-xs opacity-60">Monthly limit: $' + Number(account.extra_usage_monthly_usd).toFixed(2) + usedCredits + '</div>' : '';
													const subscriptionHtml = subscription ? '<div class="text-sm opacity-90">' + escapeHTML(subscription) + '</div>' : '';
													const metaHtml = meta ? '<div class="text-xs opacity-80">' + escapeHTML(meta) + '</div>' : '';
													const detailHtml = detail ? '<div class="text-xs opacity-60">' + escapeHTML(detail) + '</div>' : '';
													return '<div class="card bg-base-100 shadow-sm border border-base-300 h-full"><div class="card-body"><div class="font-semibold">' + escapeHTML(providerTitle) + '</div>' + subscriptionHtml + metaHtml + detailHtml + extraUsage + (limits || '<div class="text-xs opacity-50 mt-2">No live limit snapshot yet</div>') + error + '</div></div>';
												}).join('');
										}
									}
								}

								async function loadUsageAnalytics(refreshUsage) {
									try {
										const groupBy = document.getElementById('groupBy').value;
										const params = new URLSearchParams({ project_id: projectID, range: usageRangeParam(), group_by: groupBy });
										if (refreshUsage) params.append('refresh', 'true');
										const response = await fetch(`/api/analytics/usage?${params}`);
										if (!response.ok) return;
										latestUsageAnalytics = await response.json();
										renderUsageAnalytics(latestUsageAnalytics);
									} catch (e) { console.error('loadUsageAnalytics:', e); }
								}

								// Load Success/Failure Rates
					async function loadSuccessFailureRates() {
						try {
						const groupBy = document.getElementById('groupBy').value;
						const { dateFrom, dateTo } = getDateRange();
						const params = new URLSearchParams({ project_id: projectID, group_by: groupBy });
						if (dateFrom) params.append('date_from', dateFrom);
						if (dateTo) params.append('date_to', dateTo);

						const data = await fetchJSON(`/api/analytics/success-failure-rates?${params}`);
						if (data.length === 0) return;

						if (charts.successFailure) charts.successFailure.destroy();
						const ctx = document.getElementById('successFailureChart');
						if (!ctx) return;
						charts.successFailure = new Chart(ctx.getContext('2d'), {
							type: 'line',
							data: {
								labels: data.map(d => d.Period || 'N/A'),
								datasets: [
									{
										label: 'Success Rate (%)',
										data: data.map(d => d.SuccessRate || 0),
										borderColor: 'rgb(34, 197, 94)',
										backgroundColor: 'rgba(34, 197, 94, 0.1)',
										yAxisID: 'y'
									},
									{
										label: 'Total Executions',
										data: data.map(d => d.TotalCount || 0),
										borderColor: 'rgb(59, 130, 246)',
										backgroundColor: 'rgba(59, 130, 246, 0.1)',
										yAxisID: 'y1'
									}
								]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								interaction: { mode: 'index', intersect: false },
								scales: {
									y: { type: 'linear', display: true, position: 'left', max: 100, title: { display: true, text: 'Success Rate (%)' } },
									y1: { type: 'linear', display: true, position: 'right', title: { display: true, text: 'Total Executions' }, grid: { drawOnChartArea: false } }
								}
							}
						});
						} catch (e) { console.error('loadSuccessFailureRates:', e); }
					}

					// Load Hourly Trends
					async function loadHourlyTrends() {
						try {
						const { dateFrom, dateTo } = getDateRange();
						const params = new URLSearchParams({ project_id: projectID });
						if (dateFrom) params.append('date_from', dateFrom);
						if (dateTo) params.append('date_to', dateTo);

						const data = await fetchJSON(`/api/analytics/execution-trends-by-hour?${params}`);

						if (charts.hourlyTrends) charts.hourlyTrends.destroy();
						const ctx = document.getElementById('hourlyTrendsChart');
						if (!ctx) return;
						charts.hourlyTrends = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: Array.from({ length: 24 }, (_, i) => `${i}:00`),
								datasets: [{
									label: 'Executions',
									data: Array.from({ length: 24 }, (_, i) => {
										const found = data.find(d => d.Hour === i);
										return found ? found.Count : 0;
									}),
									backgroundColor: 'rgba(147, 51, 234, 0.5)',
									borderColor: 'rgb(147, 51, 234)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								scales: { y: { beginAtZero: true, title: { display: true, text: 'Count' } } }
							}
						});
						} catch (e) { console.error('loadHourlyTrends:', e); }
					}

					// Load Avg Execution Time by Task
					async function loadAvgTimeByTask() {
						try {
						const data = await fetchJSON(`/api/analytics/avg-execution-time-by-task?project_id=${projectID}&limit=10`);
						if (data.length === 0) return;

						if (charts.avgTimeTask) charts.avgTimeTask.destroy();
						const ctx = document.getElementById('avgTimeTaskChart');
						if (!ctx) return;
						charts.avgTimeTask = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: data.map(d => d.Name || 'Unknown'),
								datasets: [{
									label: 'Avg Time (min)',
									data: data.map(d => (d.AvgMs || 0) / 60000),
									backgroundColor: 'rgba(251, 146, 60, 0.5)',
									borderColor: 'rgb(251, 146, 60)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								indexAxis: 'y',
								scales: { x: { beginAtZero: true, title: { display: true, text: 'Minutes' } } },
								plugins: {
									tooltip: {
										callbacks: {
											label: function(context) {
												return 'Avg: ' + formatDuration(data[context.dataIndex].AvgMs || 0);
											}
										}
									}
								}
							}
						});
						} catch (e) { console.error('loadAvgTimeByTask:', e); }
					}

					// Load Avg Execution Time by Agent
					async function loadAvgTimeByAgent() {
						try {
						const data = await fetchJSON(`/api/analytics/avg-execution-time-by-agent?project_id=${projectID}`);
						if (data.length === 0) return;

						if (charts.avgTimeAgent) charts.avgTimeAgent.destroy();
						const ctx = document.getElementById('avgTimeAgentChart');
						if (!ctx) return;
						charts.avgTimeAgent = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: data.map(d => d.Name || 'Unknown'),
								datasets: [{
									label: 'Avg Time (min)',
									data: data.map(d => (d.AvgMs || 0) / 60000),
									backgroundColor: 'rgba(20, 184, 166, 0.5)',
									borderColor: 'rgb(20, 184, 166)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								scales: { y: { beginAtZero: true, title: { display: true, text: 'Minutes' } } },
								plugins: {
									tooltip: {
										callbacks: {
											label: function(context) {
												return 'Avg: ' + formatDuration(data[context.dataIndex].AvgMs || 0);
											}
										}
									}
								}
							}
						});
						} catch (e) { console.error('loadAvgTimeByAgent:', e); }
					}

					// Load Agent Usage
					async function loadAgentUsage() {
						try {
						const data = await fetchJSON(`/api/analytics/agent-usage-by-project?project_id=${projectID}`);
						if (data.length === 0) return;

						if (charts.agentUsage) charts.agentUsage.destroy();
						const ctx = document.getElementById('agentUsageChart');
						if (!ctx) return;
						charts.agentUsage = new Chart(ctx.getContext('2d'), {
							type: 'pie',
							data: {
								labels: data.map(d => d.AgentName || 'Unknown'),
								datasets: [{
									data: data.map(d => d.ExecutionCount || 0),
									backgroundColor: [
										'rgba(239, 68, 68, 0.7)',
										'rgba(34, 197, 94, 0.7)',
										'rgba(59, 130, 246, 0.7)',
										'rgba(251, 146, 60, 0.7)',
										'rgba(147, 51, 234, 0.7)',
										'rgba(20, 184, 166, 0.7)'
									]
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								plugins: { legend: { position: 'bottom' } }
							}
						});
						} catch (e) { console.error('loadAgentUsage:', e); }
					}

					// Load Most Frequent Tasks
					async function loadMostFrequentTasks() {
						try {
						const data = await fetchJSON(`/api/analytics/most-frequent-tasks?project_id=${projectID}&limit=10`);

						const container = document.getElementById('frequentTasksList');
						if (!container) return;
						if (data.length === 0) {
							container.innerHTML = '<p class="text-center opacity-50 py-4">No data available</p>';
							return;
						}

							container.innerHTML = data.map((task, idx) => `
								<div class="flex items-center justify-between gap-3 py-2 border-b border-base-300">
									<div class="flex-1 min-w-0 pr-2">
										<span class="font-mono text-sm opacity-50">${idx + 1}.</span>
										<span class="ml-2 break-words">${task.TaskTitle || 'Unknown'}</span>
									</div>
									<span class="badge badge-primary shrink-0 inline-flex items-center justify-center whitespace-nowrap h-auto min-h-6 px-3 py-1 leading-none text-center">${task.ExecutionCount || 0} runs</span>
								</div>
							`).join('');						} catch (e) { console.error('loadMostFrequentTasks:', e); }
					}

					// Load Failed Task Patterns
					async function loadFailedTaskPatterns() {
						try {
						const data = await fetchJSON(`/api/analytics/failed-task-patterns?project_id=${projectID}&limit=10`);

						const tbody = document.querySelector('#failedPatternsTable tbody');
						if (!tbody) return;
						if (data.length === 0) {
							tbody.innerHTML = '<tr><td colspan="4" class="text-center opacity-50">No failed tasks</td></tr>';
							return;
						}

						tbody.innerHTML = data.map(pattern => {
							const lastError = pattern.LastError || 'N/A';
							const truncatedError = lastError.length > 50 ? lastError.substring(0, 50) + '...' : lastError;
							const lastFailedAt = pattern.LastFailedAt ? new Date(pattern.LastFailedAt).toLocaleString() : 'N/A';
							return `
								<tr>
									<td>${pattern.TaskTitle || 'Unknown'}</td>
									<td><span class="badge badge-error">${pattern.FailureCount || 0}</span></td>
									<td><span class="text-xs" title="${lastError}">${truncatedError}</span></td>
									<td class="text-xs opacity-60">${lastFailedAt}</td>
								</tr>
							`;
						}).join('');
						} catch (e) { console.error('loadFailedTaskPatterns:', e); }
					}

					// Load all data - use Promise.allSettled to prevent one failure from blocking others
						async function loadAllData(refreshUsage) {
								await Promise.allSettled([
									loadUsageAnalytics(refreshUsage),
								loadSkillAnalytics(),
								loadSuccessFailureRates(),
							loadHourlyTrends(),
							loadAvgTimeByTask(),
							loadAvgTimeByAgent(),
							loadAgentUsage(),
							loadMostFrequentTasks(),
							loadFailedTaskPatterns()
						]);
					}

						// Event listeners
						document.getElementById('refreshBtn').addEventListener('click', function() { loadAllData(true); });
						document.getElementById('dateRange').addEventListener('change', () => {
							loadUsageAnalytics();
							loadSkillAnalytics();
							loadSuccessFailureRates();
							loadHourlyTrends();
						});
						['skillSurfaceFilter', 'skillScopeFilter', 'skillEventFilter'].forEach(function(id) {
							const el = document.getElementById(id);
							if (el) el.addEventListener('change', loadSkillAnalytics);
						});
						const skillAgentFilter = document.getElementById('skillAgentFilter');
						if (skillAgentFilter) skillAgentFilter.addEventListener('change', loadSkillAnalytics);
						document.querySelectorAll('[data-skill-panel]').forEach(function(tab) {
							tab.addEventListener('click', function() { setSkillAnalyticsPanel(tab.dataset.skillPanel); });
						});
							document.getElementById('groupBy').addEventListener('change', () => {
								loadUsageAnalytics();
								loadSuccessFailureRates();
							});
								const usageRateSelect = document.getElementById('usageRateModelSelect');
								if (usageRateSelect) usageRateSelect.addEventListener('change', () => {
									if (latestUsageAnalytics) renderUsageRateChart(latestUsageAnalytics);
								});
						// Initial load
					loadAllData();
				}

				// Load Chart.js dynamically if not already loaded, then initialize.
				// This fixes HTMX navigation: external <script src> tags load async during
				// HTMX swaps, so the inline script would run before Chart.js was available.
				if (typeof Chart !== 'undefined') {
					setTimeout(initAnalytics, 0);
				} else {
					var script = document.createElement('script');
					script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js';
					script.onload = initAnalytics;
					document.head.appendChild(script);
				}
				})();
			</script>
	} else {
		<div class="text-center py-12 opacity-50">
			<p>No projects yet. Create one to view analytics.</p>
		</div>
	}
}
