		// resolveScrollTracker returns a tracker for `messagesEl`, creating one or
		// rebinding the existing keyed tracker if the element changed (e.g. after a
		// morph swap). This is the single entry point streaming code should use to
		// avoid stale-element bugs that "freeze" smart scrolling until refresh.
			window.resolveScrollTracker = function(trackerKey, messagesEl) {
				if (!trackerKey || !messagesEl || !window.ChatScrollTracker) return null;
				var existing = window[trackerKey];
				if (!existing) {
					window[trackerKey] = new window.ChatScrollTracker(messagesEl);
					return window[trackerKey];
				}
				// Detect stale (detached or replaced) element and rebind.
				if (existing.element !== messagesEl || !existing.element || !existing.element.isConnected) {
					existing.rebind(messagesEl);
				}
				return existing;
			};

				window._chatSendScrollIntents = window._chatSendScrollIntents || {};

				window.markChatSendScrollIntent = function(formOrMessagesId) {
					var messagesId = '';
					if (typeof formOrMessagesId === 'string') {
						messagesId = formOrMessagesId;
					} else if (formOrMessagesId && formOrMessagesId.getAttribute) {
						var target = formOrMessagesId.getAttribute('hx-target') || '';
						messagesId = target.charAt(0) === '#' ? target.substring(1) : target;
					}
					if (!messagesId) return;
					window._chatSendScrollIntents[messagesId] = true;
					var messagesEl = document.getElementById(messagesId);
					var trackerKey = 'scrollTracker_' + messagesId;
					var tracker = window.resolveScrollTracker ? window.resolveScrollTracker(trackerKey, messagesEl) : window[trackerKey];
					if (tracker && tracker.resetOnUserSend) tracker.resetOnUserSend();
				};

				window.consumeChatSendScrollIntent = function(messagesId) {
					if (!messagesId || !window._chatSendScrollIntents || !window._chatSendScrollIntents[messagesId]) return false;
					delete window._chatSendScrollIntents[messagesId];
					return true;
				};

				window.hasChatSendScrollIntent = function(messagesId) {
					return !!(messagesId && window._chatSendScrollIntents && window._chatSendScrollIntents[messagesId]);
				};

				window.scrollChatToBottomAfterLayout = function(messagesEl, smooth) {
					if (!messagesEl || !window.chatAutoScroll) return;
					requestAnimationFrame(function() {
						requestAnimationFrame(function() {
							var liveMessages = messagesEl;
							if (messagesEl.id) {
								var resolved = document.getElementById(messagesEl.id);
								if (resolved) liveMessages = resolved;
							}
							if (liveMessages && window.chatAutoScroll) {
								window.chatAutoScroll.scrollToBottom(liveMessages, !!smooth);
							}
						});
					});
				};

				window.bindAttachmentImageSmartScroll = function(messagesEl, trackerKey, trackerFallback) {
					if (!messagesEl || !window.chatAutoScroll) return;
					var messagesId = messagesEl.id || '';
					var hasSendIntent = window.hasChatSendScrollIntent(messagesId);
					var images = messagesEl.querySelectorAll('img[data-chat-attachment-image="true"]');
					images.forEach(function(img) {
						if (img.dataset.smartScrollBound === 'true') return;
						img.dataset.smartScrollBound = 'true';
						var shouldScroll = false;
						function snapshotPinnedState() {
							var liveMessages = messagesEl;
							if (messagesEl.id) {
								var resolved = document.getElementById(messagesEl.id);
								if (resolved) liveMessages = resolved;
							}
							var tracker = trackerKey && window.resolveScrollTracker ? window.resolveScrollTracker(trackerKey, liveMessages) : trackerFallback;
							if (hasSendIntent && tracker) tracker.userScrolledUp = false;
							shouldScroll = hasSendIntent || !tracker || tracker.shouldAutoScroll();
						}
						function scrollAfterImageLayout() {
							if (!shouldScroll) return;
							var liveMessages = messagesEl;
							if (messagesEl.id) {
								var resolved = document.getElementById(messagesEl.id);
								if (resolved) liveMessages = resolved;
							}
							var tracker = trackerKey && window.resolveScrollTracker ? window.resolveScrollTracker(trackerKey, liveMessages) : trackerFallback;
							if (tracker && !tracker.shouldAutoScroll()) return;
							window.scrollChatToBottomAfterLayout(liveMessages, false);
						}
						snapshotPinnedState();
						if (img.complete) {
