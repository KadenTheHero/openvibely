package components

import (
	"fmt"
	llmtranscript "github.com/openvibely/openvibely/internal/llm/transcript"
	"github.com/openvibely/openvibely/internal/models"
	"regexp"
	"strings"
	"time"
)

// jsStringLength returns the JavaScript string.length for a Go string.
// JS uses UTF-16 encoding, so characters outside the BMP (U+10000+) count as
// 2 code units (surrogate pair), matching how JS .length works.
func jsStringLength(s string) int {
	n := 0
	for _, r := range s {
		if r >= 0x10000 {
			n += 2 // surrogate pair
		} else {
			n += 1
		}
	}
	return n
}

// ChatInputFormConfig holds configuration for the shared chat input form.
type ChatInputFormConfig struct {
	FormID                 string
	InputID                string
	PostEndpoint           string
	TargetID               string
	Agents                 []models.LLMConfig
	ShowModelSelector      bool
	ShowModeSelector       bool
	ChatMode               models.ChatMode // default when not persisted
	TaskID                 string          // non-empty enables cancel button when IsRunning
	IsRunning              bool
	ActiveTurnID           string
	ProjectID              string // non-empty enables model selection persistence via localStorage
	SelectedAgentID        string // initial model selection; defaults to auto when empty
	PendingInputs          []models.ThreadInput
	QueuedSteerEndpointFor func(models.ThreadInput) string
}

// chatElementIDs returns derived element IDs based on the form ID prefix.
func chatAttachmentPreviewID(formID string) string { return formID + "-attachments-preview" }
func chatAttachmentListID(formID string) string    { return formID + "-attachments-list" }
func chatSessionInputID(formID string) string      { return formID + "-session-id" }
func chatFileInputID(formID string) string         { return formID + "-file-input" }
func chatDropOverlayID(formID string) string       { return formID + "-drop-overlay" }
func chatMessageHistoryStorageKey(config ChatInputFormConfig) string {
	if config.TaskID != "" {
		return "openvibely-task-thread-message-history-" + config.TaskID
	}
	return "openvibely-chat-message-history"
}
func selectedAgentOrAuto(agentID string) string {
	if agentID == "" {
		return "auto"
	}
	return agentID
}

func chatModeOrDefault(mode models.ChatMode) string {
	if mode == "" {
		return string(models.ChatModeOrchestrate)
	}
	return string(mode)
}

func hasPendingComposerInputs(inputs []models.ThreadInput) bool {
	for _, input := range inputs {
		if input.InputMode == models.ThreadInputModeQueued || input.InputMode == models.ThreadInputModeSteering {
			return true
		}
	}
	return false
}

templ ChatLoadingDots(size string) {
	<span
		class={
			"ov-loading-dots",
			templ.KV("ov-loading-dots-xs", size == "xs"),
			templ.KV("ov-loading-dots-sm", size != "xs"),
		}
		aria-hidden="true"
	>
		<span class="ov-loading-dot"></span>
		<span class="ov-loading-dot"></span>
		<span class="ov-loading-dot"></span>
	</span>
}

// ChatBubble renders a static chat message bubble (completed or failed text).
templ ChatBubble(role, content string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if role == "User" {
				<div class="whitespace-pre-wrap leading-relaxed text-sm" style="word-wrap: break-word;">{ CleanDisplayContent(content) }</div>
			} else {
				<div class="chat-stream-content" data-raw-content={ NormalizeDisplayMarkers(content) }></div>
				<script>
					(function() {
						var el = document.currentScript.previousElementSibling;
						function render() {
							var raw = el.getAttribute('data-raw-content');
							if (window.renderStreamingContent && raw) {
								window.renderStreamingContent(el, raw);
							} else if (window.renderChatMarkdown && raw) {
								el.classList.add('chat-markdown');
								el.innerHTML = window.renderChatMarkdown(raw);
								if (window.addCodeCopyButtons) window.addCodeCopyButtons(el);
							} else {
								el.textContent = raw;
								el.classList.add('whitespace-pre-wrap');
							}
						// After rendering, process task links and clean markers
						var bubble = el.closest('.chat-bubble-user-msg, .chat-bubble-assistant-msg');
						if (bubble) {
							if (window.convertTaskLinksInMessage) window.convertTaskLinksInMessage(bubble);
							if (window.convertTaskEditLinksInMessage) window.convertTaskEditLinksInMessage(bubble);
							if (window.cleanBubbleContent) window.cleanBubbleContent(bubble);
						}
						}
						// renderStreamingContent may not be defined yet (defined later in page).
						if (window.renderStreamingContent) { render(); }
						else {
							// Poll until renderStreamingContent is defined (defined by ChatAutoScrollScript later in page)
							var poll = setInterval(function() {
								if (window.renderStreamingContent) { clearInterval(poll); render(); }
							}, 10);
							setTimeout(function() { clearInterval(poll); render(); }, 2000); // fallback
						}
					})();
				</script>
			}
		</div>
	</div>
}

// ChatBubbleError renders an assistant error message bubble.
templ ChatBubbleError(role, errorMsg, output string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if errorMsg != "" {
				<div class="text-error/80 text-sm font-medium mb-2">{ "Error: " + errorMsg }</div>
			}
			if output != "" {
				<div class="chat-stream-content" data-raw-content={ NormalizeDisplayMarkers(output) }></div>
				<script>
					(function() {
						var el = document.currentScript.previousElementSibling;
						function render() {
							var raw = el.getAttribute('data-raw-content');
							if (window.renderStreamingContent && raw) {
								window.renderStreamingContent(el, raw);
							} else if (window.renderChatMarkdown && raw) {
								el.classList.add('chat-markdown');
								el.innerHTML = window.renderChatMarkdown(raw);
								if (window.addCodeCopyButtons) window.addCodeCopyButtons(el);
							} else {
								el.textContent = raw;
								el.classList.add('whitespace-pre-wrap');
							}
						}
						if (window.renderStreamingContent) { render(); }
						else {
							var poll = setInterval(function() {
								if (window.renderStreamingContent) { clearInterval(poll); render(); }
							}, 10);
							setTimeout(function() { clearInterval(poll); render(); }, 2000);
						}
					})();
				</script>
			}
		</div>
	</div>
}

// ChatBubbleThinking renders a loading/thinking indicator bubble.
templ ChatBubbleThinking(role string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			<div id="streaming-message" class="flex flex-col items-start gap-1">
				<span class="block h-5" aria-hidden="true"></span>
				@ChatLoadingDots("sm")
			</div>
		</div>
	</div>
}

// ChatBubbleRunning renders a running bubble with partial output and a loading indicator.
templ ChatBubbleRunning(role, partialOutput string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if cleanedOutput := CleanDisplayContent(partialOutput); cleanedOutput == "" || strings.TrimSpace(cleanedOutput) == "" {
				<div id="streaming-message" class="flex items-center gap-2">
					@ChatLoadingDots("sm")
					<span class="text-sm opacity-60">Working...</span>
				</div>
			} else {
				<div class="whitespace-pre-wrap leading-relaxed text-sm" style="word-wrap: break-word;">{ cleanedOutput }</div>
				<div class="flex items-center gap-1 mt-2 opacity-40">
					@ChatLoadingDots("xs")
				</div>
			}
		</div>
	</div>
}

// ChatBubbleWithAttachments renders a message with inline attachment display.
templ ChatBubbleWithAttachments(role, content string, attachments []models.ChatAttachment) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2 flex items-center gap-2">
			{ role }
			if len(attachments) > 0 {
				<span class="badge badge-sm badge-neutral">
					<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
					</svg>
					{ fmt.Sprintf("%d", len(attachments)) }
				</span>
			}
		</div>
		<div class="chat-bubble-inner">
			<div class="whitespace-pre-wrap leading-relaxed text-sm" style="word-wrap: break-word;">{ CleanDisplayContent(content) }</div>
			if len(attachments) > 0 {
				<div class="mt-3 pt-3 border-t border-base-content/10">
					<div class="text-xs font-medium opacity-70 mb-2">Attachments</div>
					for _, att := range attachments {
						if IsImageMediaType(att.MediaType) {
							<div class="mb-3">
								<a href={ templ.SafeURL(fmt.Sprintf("/chat/attachments/%s/download", att.ID)) } target="_blank" class="block">
									<img
										src={ templ.SafeURL(fmt.Sprintf("/chat/attachments/%s/download", att.ID)) }
										alt={ att.FileName }
										class="max-w-full rounded-lg border border-base-content/10 hover:opacity-90 transition-opacity cursor-pointer"
										style="max-height: 400px; object-fit: contain;"
										loading="lazy"
										data-chat-attachment-image="true"
									/>
								</a>
								<div class="flex items-center gap-2 text-xs opacity-60 mt-1.5">
									<svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
									<span class="font-medium">{ att.FileName }</span>
									<span>({ FormatFileSize(att.FileSize) })</span>
								</div>
							</div>
						} else {
							<div class="flex items-center gap-2 text-xs opacity-90 mb-1.5">
								<svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
								</svg>
								<a href={ templ.SafeURL(fmt.Sprintf("/chat/attachments/%s/download", att.ID)) } class="hover:underline font-medium" target="_blank">
									{ att.FileName }
								</a>
								<span class="opacity-60">({ FormatFileSize(att.FileSize) })</span>
							</div>
						}
					}
				</div>
			}
		</div>
	</div>
}

// ChatBubbleStreaming renders a streaming SSE message bubble for new messages.
// messagesContainerID: the ID of the scrollable messages container (e.g. "chat-messages" or "task-thread-messages")
// pausePollingTargetID: if non-empty, pauses HTMX polling on this element during streaming (thread uses "task-thread-view")
// isThread: true uses thread behavior (refresh on done); false uses main-chat behavior (link conversion + marker cleaning)
templ ChatBubbleStreaming(role, execID, messagesContainerID, pausePollingTargetID string, isThread bool) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			<div id={ "streaming-thinking-" + execID } class="flex flex-col items-start gap-1">
				<span class="block h-5" aria-hidden="true"></span>
				@ChatLoadingDots("sm")
			</div>
			<div
				id={ "streaming-message-" + execID }
				class="whitespace-pre-wrap leading-relaxed text-sm hidden"
				data-exec-id={ execID }
				data-messages-container={ messagesContainerID }
				data-pause-polling-target={ pausePollingTargetID }
				data-is-thread={ boolStr(isThread) }
				style="word-wrap: break-word;"
			></div>
			<div id={ "streaming-dots-" + execID } class="hidden flex items-center gap-1 mt-2 opacity-40">
				@ChatLoadingDots("xs")
			</div>
			<script type="text/javascript">
				(function() {
					var streamingDots = document.currentScript.previousElementSibling;
					var container = streamingDots.previousElementSibling;
					var thinkingIndicator = container.previousElementSibling;
					var execId = container.getAttribute('data-exec-id');
					var messagesId = container.getAttribute('data-messages-container');
					var pauseTarget = container.getAttribute('data-pause-polling-target');
					var isThread = container.getAttribute('data-is-thread') === 'true';
					// Pause HTMX polling if requested (prevents morph:outerHTML from destroying the EventSource)
					if (pauseTarget) {
						window._taskThreadStreamingActive = true;
						var pollingEl = document.getElementById(pauseTarget);
							if (pollingEl) {
								if (!pollingEl.hasAttribute('data-paused-hx-trigger')) {
									pollingEl.setAttribute('data-paused-hx-trigger', pollingEl.getAttribute('hx-trigger') || '');
								}
								if (!pollingEl.hasAttribute('data-paused-hx-get')) {
									pollingEl.setAttribute('data-paused-hx-get', pollingEl.getAttribute('hx-get') || '');
								}
								pollingEl.removeAttribute('hx-trigger');
								pollingEl.removeAttribute('hx-get');
								htmx.process(pollingEl);
							}
						}

						function stopThreadPolling() {
							if (!pauseTarget) return;
							var pollingEl = document.getElementById(pauseTarget);
							if (!pollingEl) return;
							pollingEl.setAttribute('data-task-active', 'false');
							pollingEl.removeAttribute('hx-trigger');
							pollingEl.removeAttribute('hx-get');
							if (typeof htmx !== 'undefined') htmx.process(pollingEl);
						}

						function restoreThreadPollingFallback() {
							if (!pauseTarget) return;
							var pollingEl = document.getElementById(pauseTarget);
							if (!pollingEl || pollingEl.getAttribute('data-task-active') === 'false') return;
							var pausedTrigger = pollingEl.getAttribute('data-paused-hx-trigger');
							var pausedGet = pollingEl.getAttribute('data-paused-hx-get');
							if (pausedTrigger) pollingEl.setAttribute('hx-trigger', pausedTrigger);
							if (pausedGet) pollingEl.setAttribute('hx-get', pausedGet);
							if (typeof htmx !== 'undefined') htmx.process(pollingEl);
						}

						function showThreadTerminalStatus(status) {
							stopThreadPolling();
							var form = document.getElementById('task-thread-form');
							if (form) {
								var textarea = document.getElementById('task-message-input');
								if (textarea) textarea.setAttribute('placeholder', 'Type your message... (Enter to send, Shift+Enter for new line)');
								var cancelButton = form.querySelector('button[title="Cancel running task"]');
								if (cancelButton) cancelButton.remove();
							}
							var messages = document.getElementById(messagesId);
							if (!messages || document.getElementById('task-thread-terminal-status')) return;
							var wrap = document.createElement('div');
							wrap.id = 'task-thread-terminal-status';
							wrap.className = 'flex items-center justify-center gap-2 py-2';
							var inner = document.createElement('div');
							inner.className = 'flex items-center gap-2 text-sm opacity-70 ' + (status === 'failed' ? 'text-error' : 'text-success');
							var icon = document.createElement('span');
							icon.setAttribute('aria-hidden', 'true');
							icon.textContent = status === 'failed' ? '✕' : '✓';
							var text = document.createElement('span');
							text.textContent = 'Task ' + (status === 'failed' ? 'failed' : 'completed');
							inner.appendChild(icon);
							inner.appendChild(text);
							wrap.appendChild(inner);
							messages.appendChild(wrap);
						}

					// Get or create page-level tracker for this chat container.
					// resolveScrollTracker handles stale/replaced elements (morph swaps),
					// which is what previously caused smart scrolling to "freeze" in
					// long-lived conversations until a full page refresh.
				var chatMessages = document.getElementById(messagesId);
				var tracker = null;
				var trackerKey = 'scrollTracker_' + messagesId;

				if (chatMessages) {
					if (window.resolveScrollTracker) {
						tracker = window.resolveScrollTracker(trackerKey, chatMessages);
					} else {
						if (!window[trackerKey]) {
							window[trackerKey] = new window.ChatScrollTracker(chatMessages);
						}
						tracker = window[trackerKey];
					}
					// User just sent a message: reset scroll tracking and pin to bottom.
					if (tracker) tracker.resetOnUserSend();
				}
					// Buffer for accumulating streaming content
					var textBuffer = '';
					var renderScheduled = false;
					var lastRenderedLength = 0;
					function renderBufferedOutput(force) {
						if (!window.renderStreamingContent) {
							container.textContent = window.normalizeTranscriptMarkers ? window.normalizeTranscriptMarkers(textBuffer) : textBuffer;
							return;
						}
						if (!force && renderScheduled) return;
					var runRender = function() {
						renderScheduled = false;
						var renderText = window.normalizeTranscriptMarkers ? window.normalizeTranscriptMarkers(textBuffer) : textBuffer;
						if (!force && renderText.length === lastRenderedLength) return;
						// Refresh tracker against the live messages element. If a morph
						// swap replaced the container mid-stream, the old tracker would
						// be holding a detached element and isNearBottom() would always
						// be true — causing endless auto-scroll until page refresh.
						var liveMessages = document.getElementById(messagesId);
						if (liveMessages && window.resolveScrollTracker) {
							tracker = window.resolveScrollTracker(trackerKey, liveMessages);
						}
						var shouldScroll = !tracker || tracker.shouldAutoScroll();
						container.setAttribute('data-raw-content', renderText);
						window.renderStreamingContent(container, renderText);
						lastRenderedLength = renderText.length;
						// Auto-scroll only if the viewport was pinned before this render grew the DOM.
						if (shouldScroll) {
							requestAnimationFrame(function() {
								var chatMessages = document.getElementById(messagesId);
								if (chatMessages) {
									window.chatAutoScroll.scrollToBottom(chatMessages, false);
								}
							});
						}
					};						if (force) {
							runRender();
							return;
						}
						renderScheduled = true;
						requestAnimationFrame(runRender);
					}

					var streamRetryCount = 0;
					var eventSource = null;
					function connectExecutionStream() {
						eventSource = new EventSource('/events/chat/' + execId);
						if (!isThread && window.registerChatStreamEventSource) {
							window.registerChatStreamEventSource(execId, eventSource);
						}
					function removeThreadEventSource(es) {
						if (!window._threadEventSources || !es) return;
						var idx = window._threadEventSources.indexOf(es);
						if (idx >= 0) window._threadEventSources.splice(idx, 1);
					}
					function removeChatEventSource(execId, es) {
						if (!window.unregisterChatStreamEventSource) return;
						window.unregisterChatStreamEventSource(execId, es);
					}
					// Track thread stream EventSource so navigation cleanup can close it.
					if (isThread) {
						if (!window._threadEventSources) window._threadEventSources = [];
						window._threadEventSources.push(eventSource);
					}

					eventSource.onmessage = function(event) {
						// Hide thinking indicator and show content on first message
						if (thinkingIndicator && !thinkingIndicator.classList.contains('hidden')) {
							thinkingIndicator.classList.add('hidden');
							container.classList.remove('hidden');
							streamingDots.classList.remove('hidden');
						}
						
						// Append to buffer and re-render
						textBuffer += event.data;
						// Persist normalized render content for completion fallback logic
						container.setAttribute('data-raw-content', window.normalizeTranscriptMarkers ? window.normalizeTranscriptMarkers(textBuffer) : textBuffer);
						renderBufferedOutput(false);
					};

					eventSource.addEventListener('done', function(event) {
						renderBufferedOutput(true);
						// Hide streaming dots
						if (streamingDots) streamingDots.classList.add('hidden');
						eventSource.close();
						removeThreadEventSource(eventSource);
						removeChatEventSource(execId, eventSource);
						window._taskThreadStreamingActive = false;
						if (isThread) {
							showThreadTerminalStatus('completed');
						} else {
							// Always evaluate plan-completion first so prompt visibility updates
							// even if post-render transforms throw.
							if (window.handlePlanModeCompletion) {
								window.handlePlanModeCompletion(textBuffer);
							}
							// Convert task links BEFORE cleaning markers
							var bubble = container.closest('.chat-bubble-assistant-msg');
							try {
								if (bubble && window.convertTaskLinksInMessage) {
									window.convertTaskLinksInMessage(bubble);
								}
								if (bubble && window.convertTaskEditLinksInMessage) {
									window.convertTaskEditLinksInMessage(bubble);
								}
								if (bubble && window.cleanBubbleContent) {
									window.cleanBubbleContent(bubble);
								}
							} catch (err) {
								console.error('[chat] post-stream transform failed:', err);
							}
							// Final scroll if tracker allows it
							if (!tracker || tracker.shouldAutoScroll()) {
								requestAnimationFrame(function() {
									var chatMessages = document.getElementById(messagesId);
									if (chatMessages) {
										window.chatAutoScroll.scrollToBottom(chatMessages, true);
									}
								});
							}
						}
					});

					eventSource.addEventListener('error', function(event) {
						var retryableEarlyError = textBuffer === '' && event.data === 'execution not found' && streamRetryCount < 5;
						eventSource.close();
						removeThreadEventSource(eventSource);
						removeChatEventSource(execId, eventSource);
						if (retryableEarlyError) {
							streamRetryCount++;
							setTimeout(connectExecutionStream, 150 * streamRetryCount);
							return;
						}
						// Hide thinking indicator and streaming dots, ensure content shows
						if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
						if (streamingDots) streamingDots.classList.add('hidden');
						container.classList.remove('hidden');
						if (event.data) {
							container.appendChild(document.createTextNode('\n\nError: ' + event.data));
						}
						window._taskThreadStreamingActive = false;
						if (isThread) {
							showThreadTerminalStatus('failed');
						} else {
							// Clear streaming flag and re-evaluate plan prompt on error.
							// The evaluator scans DOM for latest completed bubble; an error
							// bubble without <proposed_plan> correctly hides the prompt.
							window._chatStreamInProgress = false;
							if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
						}
					});

					eventSource.onerror = function(error) {
						console.error('EventSource failed:', error);
						eventSource.close();
						removeThreadEventSource(eventSource);
						removeChatEventSource(execId, eventSource);
						if (textBuffer === '' && streamRetryCount < 5) {
							streamRetryCount++;
							setTimeout(connectExecutionStream, 150 * streamRetryCount);
							return;
						}
						// Hide thinking indicator and streaming dots, ensure content shows
						if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
						if (streamingDots) streamingDots.classList.add('hidden');
						container.classList.remove('hidden');
						window._taskThreadStreamingActive = false;
						if (isThread) {
							restoreThreadPollingFallback();
						} else {
							window._chatStreamInProgress = false;
							if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
						}
					};
					}
					connectExecutionStream();
				})();
			</script>
		</div>
	</div>
}

// ChatBubbleStreamingResume renders a chat message that reconnects to an in-progress SSE stream.
// The EventSource is initialized by _initThreadStreaming() (called from TaskThreadView's
// afterSwap handler) since inline scripts don't re-execute after morph:outerHTML swaps.
// Content is stored in data-raw-content (not as text content) so it renders formatted
// immediately via the inline script, matching ChatBubble's pattern. This prevents
// raw/unformatted text flash on hard refresh.
templ ChatBubbleStreamingResume(role, partialContent, execID, messagesContainerID, pausePollingTargetID string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if partialContent == "" {
				<div id={ "streaming-thinking-resume-" + execID } class="flex flex-col items-start gap-1">
					<span class="block h-5" aria-hidden="true"></span>
					@ChatLoadingDots("sm")
				</div>
			}
			<div id={ "streaming-message-" + execID } class={ "leading-relaxed text-sm", templ.KV("hidden", partialContent == "") } data-exec-id={ execID } data-initial-length={ fmt.Sprintf("%d", jsStringLength(NormalizeDisplayMarkers(partialContent))) } data-messages-container={ messagesContainerID } data-pause-polling-target={ pausePollingTargetID } data-streaming-resume="true" data-raw-content={ NormalizeDisplayMarkers(partialContent) } style="word-wrap: break-word;"></div>
			<script>
				(function() {
					var el = document.currentScript.previousElementSibling;
					function render() {
						var raw = el.getAttribute('data-raw-content');
						if (!raw) return;
						if (window.renderStreamingContent) {
							window.renderStreamingContent(el, raw);
						} else if (window.renderChatMarkdown) {
							el.className = el.className.replace('whitespace-pre-wrap', '').trim();
							var div = document.createElement('div');
							div.className = 'chat-markdown';
							div.innerHTML = window.renderChatMarkdown(raw);
							if (window.addCodeCopyButtons) window.addCodeCopyButtons(div);
							el.innerHTML = '';
							el.appendChild(div);
						} else {
							el.textContent = raw;
							el.classList.add('whitespace-pre-wrap');
						}
					}
					if (window.renderStreamingContent) { render(); }
					else {
						var poll = setInterval(function() {
							if (window.renderStreamingContent) { clearInterval(poll); render(); }
						}, 10);
						setTimeout(function() { clearInterval(poll); render(); }, 2000);
					}
				})();
			</script>
			<div id={ "streaming-dots-resume-" + execID } class={ "flex items-center gap-1 mt-2 opacity-40", templ.KV("hidden", partialContent == "") }>
				@ChatLoadingDots("xs")
			</div>
		</div>
	</div>
}

// _initThreadStreamingScript emits the global _initThreadStreaming function.
// It finds [data-streaming-resume] containers without an active EventSource
// and connects them to the SSE endpoint. Called on initial page load and
// after each morph:outerHTML swap from TaskThreadView's afterSwap handler.
templ _initThreadStreamingScript() {
	<script type="text/javascript">
		window._initThreadStreaming = function() {
			var containers = document.querySelectorAll('[data-streaming-resume="true"]');
			containers.forEach(function(container) {
				// Skip if already connected
				if (container._sseConnected) return;
				container._sseConnected = true;

				var execId = container.getAttribute('data-exec-id');
				var messagesId = container.getAttribute('data-messages-container');
				var pauseTarget = container.getAttribute('data-pause-polling-target');
				var initialLength = parseInt(container.getAttribute('data-initial-length') || '0', 10);
				var cumulativeContent = '';

				// Find streaming dots by ID (reliable across morph swaps and inline script siblings)
				var streamingDots = document.getElementById('streaming-dots-resume-' + execId);
				// Content is in data-raw-content attribute (not textContent)
				var hasContent = !!container.getAttribute('data-raw-content');
				var thinkingIndicator = !hasContent ? container.previousElementSibling : null;

				// Pause HTMX polling if requested
				if (pauseTarget) {
					window._taskThreadStreamingActive = true;
					var pollingEl = document.getElementById(pauseTarget);
						if (pollingEl) {
							if (!pollingEl.hasAttribute('data-paused-hx-trigger')) {
								pollingEl.setAttribute('data-paused-hx-trigger', pollingEl.getAttribute('hx-trigger') || '');
							}
							if (!pollingEl.hasAttribute('data-paused-hx-get')) {
								pollingEl.setAttribute('data-paused-hx-get', pollingEl.getAttribute('hx-get') || '');
							}
							pollingEl.removeAttribute('hx-trigger');
							pollingEl.removeAttribute('hx-get');
							if (typeof htmx !== 'undefined') htmx.process(pollingEl);
						}
					}

					function stopThreadPolling() {
						if (!pauseTarget) return;
						var pollingEl = document.getElementById(pauseTarget);
						if (!pollingEl) return;
						pollingEl.setAttribute('data-task-active', 'false');
						pollingEl.removeAttribute('hx-trigger');
						pollingEl.removeAttribute('hx-get');
						if (typeof htmx !== 'undefined') htmx.process(pollingEl);
					}

					function restoreThreadPollingFallback() {
						if (!pauseTarget) return;
						var pollingEl = document.getElementById(pauseTarget);
						if (!pollingEl || pollingEl.getAttribute('data-task-active') === 'false') return;
						var pausedTrigger = pollingEl.getAttribute('data-paused-hx-trigger');
						var pausedGet = pollingEl.getAttribute('data-paused-hx-get');
						if (pausedTrigger) pollingEl.setAttribute('hx-trigger', pausedTrigger);
						if (pausedGet) pollingEl.setAttribute('hx-get', pausedGet);
						if (typeof htmx !== 'undefined') htmx.process(pollingEl);
					}

						function showThreadTerminalStatus(status) {
							stopThreadPolling();
							var form = document.getElementById('task-thread-form');						if (form) {
							var textarea = document.getElementById('task-message-input');
							if (textarea) textarea.setAttribute('placeholder', 'Type your message... (Enter to send, Shift+Enter for new line)');
							var cancelButton = form.querySelector('button[title="Cancel running task"]');
							if (cancelButton) cancelButton.remove();
						}
						var messages = document.getElementById(messagesId);
						if (!messages || document.getElementById('task-thread-terminal-status')) return;
						var wrap = document.createElement('div');
						wrap.id = 'task-thread-terminal-status';
						wrap.className = 'flex items-center justify-center gap-2 py-2';
						var inner = document.createElement('div');
						inner.className = 'flex items-center gap-2 text-sm opacity-70 ' + (status === 'failed' ? 'text-error' : 'text-success');
						var icon = document.createElement('span');
						icon.setAttribute('aria-hidden', 'true');
						icon.textContent = status === 'failed' ? '✕' : '✓';
						var text = document.createElement('span');
						text.textContent = 'Task ' + (status === 'failed' ? 'failed' : 'completed');
						inner.appendChild(icon);
						inner.appendChild(text);
						wrap.appendChild(inner);
						messages.appendChild(wrap);
					}

					// Get or reuse page-level tracker. Use resolveScrollTracker so a
					// morph swap of #task-thread-messages mid-stream rebinds the tracker
					// instead of leaving it pointing at a detached element (which would
					// make isNearBottom always true and pull the user back down forever).
				var chatMessages = document.getElementById(messagesId);
				var tracker = null;
				var trackerKey = 'scrollTracker_' + messagesId;
				if (chatMessages) {
					if (window.resolveScrollTracker) {
						tracker = window.resolveScrollTracker(trackerKey, chatMessages);
					} else if (window.ChatScrollTracker) {
						if (!window[trackerKey]) {
							window[trackerKey] = new window.ChatScrollTracker(chatMessages);
						}
						tracker = window[trackerKey];
					}
				}

				var eventSource = null;
				var streamRetryCount = 0;
				var renderScheduled = false;
				var lastRenderedLength = 0;
				function renderCumulativeContent(force) {
					if (!window.renderStreamingContent) {
						container.textContent = window.normalizeTranscriptMarkers ? window.normalizeTranscriptMarkers(cumulativeContent) : cumulativeContent;
						return;
					}
					if (!force && renderScheduled) return;
					var runRender = function() {
						renderScheduled = false;
						var renderText = window.normalizeTranscriptMarkers ? window.normalizeTranscriptMarkers(cumulativeContent) : cumulativeContent;
						if (!force && renderText.length === lastRenderedLength) return;
						// Refresh tracker against the live messages element in case a
						// morph swap replaced the container while streaming.
						var liveMessages = document.getElementById(messagesId);
						if (liveMessages && window.resolveScrollTracker) {
							tracker = window.resolveScrollTracker(trackerKey, liveMessages);
						}
						var shouldScroll = !tracker || tracker.shouldAutoScroll();
						container.setAttribute('data-raw-content', renderText);
						window.renderStreamingContent(container, renderText);
						lastRenderedLength = renderText.length;
						if (shouldScroll) {
							requestAnimationFrame(function() {
								var cm = document.getElementById(messagesId);
								if (cm && window.chatAutoScroll) window.chatAutoScroll.scrollToBottom(cm, false);
							});
						}
					};
					if (force) {
						runRender();
						return;
					}
					renderScheduled = true;
					requestAnimationFrame(runRender);
				}
				function removeThreadEventSource(es) {
					if (!window._threadEventSources || !es) return;
					var idx = window._threadEventSources.indexOf(es);
					if (idx >= 0) window._threadEventSources.splice(idx, 1);
				}
				function connectResumeExecutionStream() {
					eventSource = new EventSource('/events/chat/' + execId);
					// Track EventSource globally so sidebar navigation can close it
					if (!window._threadEventSources) window._threadEventSources = [];
					window._threadEventSources.push(eventSource);

				eventSource.onmessage = function(event) {
					cumulativeContent += event.data;
					if (cumulativeContent.length >= initialLength) {
						if (thinkingIndicator && !thinkingIndicator.classList.contains('hidden')) {
							thinkingIndicator.classList.add('hidden');
							container.classList.remove('hidden');
							if (streamingDots) streamingDots.classList.remove('hidden');
						}
						renderCumulativeContent(false);
					}
				};

				eventSource.addEventListener('done', function(event) {
					renderCumulativeContent(true);
					if (streamingDots) streamingDots.classList.add('hidden');
					eventSource.close();
					removeThreadEventSource(eventSource);
					window._taskThreadStreamingActive = false;
					if (pauseTarget) {
						showThreadTerminalStatus('completed');
					} else {
						var bubble = container.closest('.chat-bubble-assistant-msg');
						if (bubble && window.convertTaskLinksInMessage) window.convertTaskLinksInMessage(bubble);
						if (bubble && window.convertTaskEditLinksInMessage) window.convertTaskEditLinksInMessage(bubble);
						if (bubble && window.cleanBubbleContent) window.cleanBubbleContent(bubble);
						if (window.handlePlanModeCompletion) window.handlePlanModeCompletion(cumulativeContent);
						if (!tracker || tracker.shouldAutoScroll()) {
							requestAnimationFrame(function() {
								var cm = document.getElementById(messagesId);
								if (cm && window.chatAutoScroll) window.chatAutoScroll.scrollToBottom(cm, true);
							});
						}
					}
				});

				eventSource.addEventListener('error', function(event) {
					var retryableEarlyError = cumulativeContent === '' && event.data === 'execution not found' && streamRetryCount < 5;
					eventSource.close();
					removeThreadEventSource(eventSource);
					if (retryableEarlyError) {
						streamRetryCount++;
						setTimeout(connectResumeExecutionStream, 150 * streamRetryCount);
						return;
					}
					if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
					if (streamingDots) streamingDots.classList.add('hidden');
					container.classList.remove('hidden');
					if (event.data) container.appendChild(document.createTextNode('\n\nError: ' + event.data));
					window._taskThreadStreamingActive = false;
					if (pauseTarget) {
						showThreadTerminalStatus('failed');
					}
				});

				eventSource.onerror = function(error) {
					console.error('EventSource failed:', error);
					eventSource.close();
					removeThreadEventSource(eventSource);
					if (cumulativeContent === '' && streamRetryCount < 5) {
						streamRetryCount++;
						setTimeout(connectResumeExecutionStream, 150 * streamRetryCount);
						return;
					}
					if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
					if (streamingDots) streamingDots.classList.add('hidden');
					container.classList.remove('hidden');
					window._taskThreadStreamingActive = false;
					if (pauseTarget) {
						restoreThreadPollingFallback();
					}
				};
				}
				connectResumeExecutionStream();
			});
		};
	</script>
}

templ ChatQueuedInputRow(inputID, message, steerEndpoint string, hasAttachments bool) {
	<div id={ "thread-input-" + inputID } class="queued-input-row flex min-h-8 items-center gap-3 rounded-lg bg-base-300/45 px-3 py-1.5 text-sm text-base-content/80" data-thread-input-id={ inputID } data-input-mode="queued" title="Queued follow-up will run after the active response finishes">
		<div class="min-w-0 flex-1 truncate">{ message }</div>
		if hasAttachments {
			<div class="badge badge-ghost badge-sm shrink-0 gap-1 text-xs" title="Attachments queued with this follow-up" aria-label="Attachments queued with this follow-up">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.586-6.586a4 4 0 00-5.657-5.657L5.757 10.757a6 6 0 108.486 8.486L21 12.486"></path>
				</svg>
				<span>Attachments queued</span>
			</div>
		}
		<div class="ml-auto flex shrink-0 items-center gap-2">
			<button type="button" class="btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs font-medium" hx-post={ steerEndpoint } hx-target={ "#thread-input-" + inputID } hx-swap="outerHTML" title="Convert queued follow-up to steering">Steer</button>
			<button type="button" class="btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs text-error" hx-post={ "/thread-inputs/" + inputID + "/cancel" } hx-target={ "#thread-input-" + inputID } hx-swap="outerHTML" title="Cancel queued follow-up" aria-label="Cancel queued follow-up">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
			</button>
		</div>
	</div>
}

templ ChatQueuedInputRowOOB(inputID, message, steerEndpoint string, hasAttachments bool) {
	<div id="pending-thread-inputs" hx-swap-oob="beforeend">
		@ChatQueuedInputRow(inputID, message, steerEndpoint, hasAttachments)
	</div>
}

templ ChatSteeringInputRow(inputID, message string) {
	<div id={ "thread-input-" + inputID } class="steering-input-row flex min-h-8 items-center gap-3 rounded-lg bg-base-300/45 px-3 py-1.5 text-sm text-base-content/80" data-thread-input-id={ inputID } data-input-mode="steering" title="Steering instruction will be applied before the active run's next model step">
		<div class="min-w-0 flex-1">
			<div class="text-xs font-semibold opacity-70">Steering pending</div>
			<div class="truncate">{ message }</div>
			<div class="text-xs opacity-60">Will be applied before the active run's next model step.</div>
		</div>
		<div class="ml-auto flex shrink-0 items-center gap-2">
			<button type="button" class="btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs text-error" hx-post={ "/thread-inputs/" + inputID + "/cancel" } hx-target={ "#thread-input-" + inputID } hx-swap="outerHTML" title="Cancel pending steering" aria-label="Cancel pending steering">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
			</button>
		</div>
	</div>
}

templ ChatComposerQueuedInputRows(inputs []models.ThreadInput, steerEndpointFor func(models.ThreadInput) string) {
	<div id="pending-thread-inputs" class="space-y-1.5">
		for _, input := range inputs {
			if input.InputMode == models.ThreadInputModeQueued && steerEndpointFor != nil {
				@ChatQueuedInputRow(input.ID, input.Content, steerEndpointFor(input), input.AttachmentSessionID != "")
			} else if input.InputMode == models.ThreadInputModeSteering {
				@ChatSteeringInputRow(input.ID, input.Content)
			}
		}
	</div>
}

templ PendingThreadInputRows(inputs []models.ThreadInput, steerEndpointFor func(models.ThreadInput) string) {
}

templ ChatInputCancelledRow(inputID string) {
	<div id={ "thread-input-" + inputID } class="hidden" data-thread-input-id={ inputID }></div>
}

templ ChatEarlierMessagesLoader(containerID, url string, limit int) {
	<div
		id={ containerID + "-earlier-loader" }
		class="py-2 text-center text-xs opacity-60"
		data-earlier-loader="true"
		data-container-id={ containerID }
		data-window-limit={ fmt.Sprintf("%d", limit) }
		hx-get={ url }
		hx-trigger="ov:load-earlier"
		hx-target={ "#" + containerID + "-earlier-loader" }
		hx-swap="outerHTML show:none"
		hx-on::before-request="window.prepareChatEarlierSwap && window.prepareChatEarlierSwap(this)"
		hx-on::after-swap="window.afterChatEarlierSwap && window.afterChatEarlierSwap(this)"
		hx-on::after-request="if (event.detail && !event.detail.successful && window.finishChatEarlierRequest) window.finishChatEarlierRequest(this)"
	>
		<span data-earlier-loader-idle>Scroll up to load earlier messages</span>
		<span data-earlier-loader-busy class="hidden"><span class="loading loading-spinner loading-xs align-middle mr-2"></span>Loading earlier messages...</span>
	</div>
}

templ ChatExecutionPair(exec models.Execution, task *models.Task, executions []models.Execution, index int, hasEarlier bool, attachments map[string][]models.ChatAttachment, messagesContainerID, pausePollingTargetID string) {
	<div class="chat-execution-pair space-y-6" data-execution-pair="true" data-exec-id={ exec.ID } data-started-at={ exec.StartedAt.Format(time.RFC3339Nano) }>
		<!-- User message: show for followups and first non-followup only -->
		if exec.IsFollowup || (!hasEarlier && !hasEarlierNonFollowup(executions, index)) {
			if atts, hasAtts := attachments[exec.ID]; hasAtts && len(atts) > 0 {
				@ChatBubbleWithAttachments("User", chatUserContent(exec, task, executions, index), atts)
			} else {
				@ChatBubble("User", chatUserContent(exec, task, executions, index))
			}
		}
		<!-- Assistant response -->
		if exec.Status == models.ExecCompleted {
			@ChatBubble("Assistant", exec.Output)
		} else if exec.Status == models.ExecFailed {
			@ChatBubbleError("Assistant", exec.ErrorMessage, exec.Output)
		} else if exec.Status == models.ExecCancelled {
			@ChatBubbleError("Assistant", "Cancelled", exec.Output)
		} else if exec.Status == models.ExecRunning {
			@ChatBubbleStreamingResume("Assistant", exec.Output, exec.ID, messagesContainerID, pausePollingTargetID)
		}
	</div>
}

// ChatFollowupResponse renders user message + streaming assistant for a follow-up.
// Used by both ChatSend (main chat) and TaskThreadSend (task thread).
templ ChatFollowupResponse(message, execID, messagesContainerID, pausePollingTargetID string, isThread bool, attachments []models.ChatAttachment) {
	<div class="chat-execution-pair space-y-6" data-execution-pair="true" data-exec-id={ execID }>
		if len(attachments) > 0 {
			@ChatBubbleWithAttachments("User", message, attachments)
		} else {
			@ChatBubble("User", message)
		}
		@ChatBubbleStreaming("Assistant", execID, messagesContainerID, pausePollingTargetID, isThread)
	</div>
}

// ChatMessages renders a list of executions as chat message bubbles.
// This is the shared message rendering loop used by both /chat and task thread.
// For task thread, deduplicates the original task prompt: only shows it for the
// first non-followup execution. Subsequent re-runs skip the user bubble.
templ ChatMessages(executions []models.Execution, task *models.Task, attachments map[string][]models.ChatAttachment, messagesContainerID, pausePollingTargetID string, hasEarlier bool) {
	for i, exec := range executions {
		@ChatExecutionPair(exec, task, executions, i, hasEarlier, attachments, messagesContainerID, pausePollingTargetID)
	}
}

// ChatEmptyState renders the empty chat placeholder.
templ ChatEmptyState(message string) {
	<div class="flex flex-col items-center justify-center h-full text-center">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-4 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
		</svg>
		<p class="text-sm opacity-50">{ message }</p>
	</div>
}

// ChatInputForm renders a shared chat input form with attachment support.
templ ChatInputForm(config ChatInputFormConfig) {
	<div class="chat-input-shadow-gutter w-full min-w-0 max-w-full pt-2 pb-4">
		<form
			id={ config.FormID }
			method="post"
			hx-post={ config.PostEndpoint }
			hx-target={ "#" + config.TargetID }
			hx-swap="beforeend"
			data-input-id={ config.InputID }
			data-clear-func-name={ config.FormID + "ClearAttachments" }
			data-message-history-key={ chatMessageHistoryStorageKey(config) }
			class="chat-input-container rounded-xl p-4 relative min-w-0 max-w-full"
		>
			<!-- Drop zone overlay -->
			<div id={ chatDropOverlayID(config.FormID) } class="hidden absolute inset-0 z-10 rounded-xl border-2 border-dashed border-primary bg-primary/10 flex items-center justify-center pointer-events-none">
				<div class="flex flex-col items-center gap-2 text-primary">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
					</svg>
					<span class="text-sm font-medium">Drop files here to attach</span>
				</div>
			</div>
			if config.ShowModelSelector {
				<input type="hidden" id={ config.FormID + "-agent-id" } name="agent_id" value={ selectedAgentOrAuto(config.SelectedAgentID) }/>
			}
			if config.ShowModeSelector {
				<input type="hidden" id={ config.FormID + "-chat-mode" } name="chat_mode" value={ chatModeOrDefault(config.ChatMode) }/>
			}
			if config.ProjectID != "" {
				<input type="hidden" id={ config.FormID + "-project-id" } name="_project_id" value={ config.ProjectID }/>
			}
			<input type="hidden" id={ chatSessionInputID(config.FormID) } name="attachment_session_id" value=""/>
			if config.ActiveTurnID != "" {
				<input type="hidden" name="expected_turn_id" value={ config.ActiveTurnID }/>
			}
			<!-- File Attachments Preview -->
			<div id={ chatAttachmentPreviewID(config.FormID) } class="hidden border-b border-base-content/[0.12] -mx-4 px-4 -mt-4 pt-2.5 pb-2.5 mb-3">
				<div class="flex items-center justify-between mb-1.5">
					<span class="text-xs font-medium opacity-70">Attached Files</span>
					<button type="button" class="btn btn-ghost btn-xs text-xs" data-clear-func={ config.FormID + "ClearAttachments" }>Clear All</button>
				</div>
				<div id={ chatAttachmentListID(config.FormID) } class="space-y-1"></div>
			</div>
			@ChatComposerQueuedInputRows(config.PendingInputs, config.QueuedSteerEndpointFor)
			<!-- Textarea -->
			<div>
				<textarea
					id={ config.InputID }
					name="message"
					class="w-full resize-none bg-transparent text-sm leading-relaxed focus:outline-none placeholder:opacity-40 p-0 text-left"
					placeholder="Type your message... (Enter to send, Shift+Enter for new line)"
					rows="3"
					enterkeyhint="send"
					required
				></textarea>
			</div>
			<!-- Bottom controls row -->
			<div class="flex items-center justify-between gap-2 pt-2 min-w-0 max-w-full overflow-hidden">
				<div class="flex items-center gap-1 -ml-2 min-w-0 flex-1 overflow-hidden">
					if config.ShowModelSelector {
						<select id={ config.FormID + "-agent-select" } class="chat-model-select select select-ghost select-xs h-7 min-h-0 text-xs font-normal opacity-50 hover:opacity-100 w-auto min-w-0 max-w-[7.5rem] sm:max-w-[140px] rounded-lg" data-agent-input={ config.FormID + "-agent-id" }>
							<option
								value="auto"
								if selectedAgentOrAuto(config.SelectedAgentID) == "auto" {
									selected
								}
							>Auto</option>
							<option
								value="default"
								if config.SelectedAgentID == "default" {
									selected
								}
							>Default</option>
							for _, agent := range config.Agents {
								<option
									value={ agent.ID }
									if config.SelectedAgentID == agent.ID {
										selected
									}
								>
									{ agent.Name } ({ agent.Model })
								</option>
							}
						</select>
					}
					if config.ShowModeSelector {
						<select id={ config.FormID + "-mode-select" } class="chat-mode-select select select-ghost select-xs h-7 min-h-0 text-xs font-normal opacity-50 hover:opacity-100 w-auto min-w-0 max-w-[6rem] sm:max-w-[120px] rounded-lg" data-mode-input={ config.FormID + "-chat-mode" }>
							<option value="orchestrate" selected>Orchestrate</option>
							<option value="plan">Plan</option>
						</select>
					}
					<!-- Cancel button for running tasks -->
					if config.TaskID != "" && config.IsRunning {
						<button
							type="button"
							class="btn btn-ghost btn-xs text-error rounded-lg"
							hx-post={ fmt.Sprintf("/tasks/%s/cancel", config.TaskID) }
							hx-swap="none"
							hx-confirm="Cancel this running task?"
							title="Cancel running task"
						>
							Cancel
						</button>
					}
				</div>
				<div class="flex items-center gap-2 flex-shrink-0">
					<!-- Attachment button -->
					<label for={ chatFileInputID(config.FormID) } class="btn btn-ghost btn-sm rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0 opacity-50 hover:opacity-100 hover:bg-base-300" title="Attach files">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
						</svg>
					</label>
					<input type="file" id={ chatFileInputID(config.FormID) } multiple class="hidden"/>
					<!-- Speech-to-text microphone button -->
					<button type="button" id={ config.FormID + "-mic-btn" } class="btn btn-ghost btn-sm rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0 opacity-50 hover:opacity-100 hover:bg-base-300 stt-btn" title="Speech to text" aria-label="Start speech to text">
						<!-- Mic icon (shown when not recording) -->
						<svg class="stt-mic-icon h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
						</svg>
						<!-- Stop icon (shown when recording) -->
						<svg class="stt-stop-icon h-4 w-4 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
							<rect x="6" y="6" width="12" height="12" rx="2"></rect>
						</svg>
					</button>
					<button type="submit" class="btn btn-primary btn-sm rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0" title="Send message">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
							<path d="M2 3l20 9-20 9 5-9-5-9z"></path>
						</svg>
					</button>
				</div>
			</div>
		</form>
	</div>
	<!-- Shared input form scripts: Enter key, file upload, drag-and-drop -->
	<script type="text/javascript">
		(function() {
			// Find our form by walking up from the script tag
			var script = document.currentScript;
			var wrapper = script ? script.previousElementSibling : null;
			var form = wrapper ? wrapper.querySelector('form.chat-input-container') : null;
			if (!form || form.tagName !== 'FORM') return;
			var formId = form.id;
			var inputId = form.querySelector('textarea[name="message"]').id;
			var messageInput = document.getElementById(inputId);
			var sessionInput = form.querySelector('input[name="attachment_session_id"]');
			var fileInput = form.querySelector('input[type="file"]');
			var preview = form.querySelector('[id$="-attachments-preview"]');
			var listContainer = form.querySelector('[id$="-attachments-list"]');
			var dropOverlay = form.querySelector('[id$="-drop-overlay"]');
			var clearBtn = form.querySelector('[data-clear-func]');
			var clearFuncName = clearBtn ? clearBtn.getAttribute('data-clear-func') : (formId + 'ClearAttachments');
				var agentSelect = form.querySelector('select[id$="-agent-select"]');
				var agentInput = agentSelect ? document.getElementById(agentSelect.getAttribute('data-agent-input')) : null;
					var modeSelect = form.querySelector('select[id$="-mode-select"]');
					var modeInput = modeSelect ? document.getElementById(modeSelect.getAttribute('data-mode-input')) : null;
						var submitBtn = form.querySelector('button[type="submit"]');
						var normalPostEndpoint = form.getAttribute('hx-post') || form.getAttribute('action') || '';
							function markSendScrollIntent() {
							if (window.markChatSendScrollIntent) window.markChatSendScrollIntent(form);
						}
							function safeSubmit() {
								if (typeof form.requestSubmit === 'function') {
									form.requestSubmit(submitBtn || undefined);
									return;
								}
								var submitEvent = new Event('submit', { bubbles: true, cancelable: true });
								form.dispatchEvent(submitEvent);
							}
							form.addEventListener('submit', markSendScrollIntent);

				var messageHistoryStorageKey = form.getAttribute('data-message-history-key') || '';
				var messageHistoryLimit = 50;
				var messageHistoryEntries = [];
				var messageHistoryIndex = -1;
				var messageHistoryDraft = '';
				var messageHistorySubmittedValue = '';
				var suppressMessageHistoryInputReset = false;

				function loadMessageHistory() {
					if (!messageHistoryStorageKey) return [];
					try {
						var raw = localStorage.getItem(messageHistoryStorageKey);
						var parsed = raw ? JSON.parse(raw) : [];
						if (!Array.isArray(parsed)) return [];
						return parsed.filter(function(entry) { return typeof entry === 'string' && entry.trim() !== ''; }).slice(-messageHistoryLimit);
					} catch (e) {
						return [];
					}
				}

				function saveMessageHistory(entries) {
					if (!messageHistoryStorageKey) return;
					try {
						localStorage.setItem(messageHistoryStorageKey, JSON.stringify(entries.slice(-messageHistoryLimit)));
					} catch (e) {
						// Ignore storage failures; keyboard navigation still works for the current page load.
					}
				}

				function rememberSubmittedMessage(message) {
					var trimmed = (message || '').trim();
					if (!trimmed) return;
					messageHistoryEntries = loadMessageHistory();
					if (messageHistoryEntries.length === 0 || messageHistoryEntries[messageHistoryEntries.length - 1] !== message) {
						messageHistoryEntries.push(message);
					}
					messageHistoryEntries = messageHistoryEntries.slice(-messageHistoryLimit);
					saveMessageHistory(messageHistoryEntries);
				}

				function resetMessageHistoryNavigation() {
					messageHistoryIndex = -1;
					messageHistoryDraft = '';
				}

				function setMessageInputFromHistory(value) {
					if (!messageInput) return;
					messageInput.value = value;
					suppressMessageHistoryInputReset = true;
					messageInput.dispatchEvent(new Event('input', { bubbles: true }));
					suppressMessageHistoryInputReset = false;
					if (typeof messageInput.setSelectionRange === 'function') {
						messageInput.setSelectionRange(0, 0);
					}
				}

				function isAtFirstLineStart(textarea) {
					if (!textarea) return false;
					var start = typeof textarea.selectionStart === 'number' ? textarea.selectionStart : 0;
					var end = typeof textarea.selectionEnd === 'number' ? textarea.selectionEnd : start;
					if (start !== end) return false;
					return start === 0;
				}

				function handleMessageHistoryKeydown(e) {
					if (!messageInput || !messageHistoryStorageKey) return false;
					if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown' && e.key !== 'Escape') return false;
					if (e.key === 'Escape') {
						if (messageHistoryIndex === -1) return false;
						e.preventDefault();
						setMessageInputFromHistory(messageHistoryDraft);
						resetMessageHistoryNavigation();
						return true;
					}
					if ((e.key === 'ArrowUp' || e.key === 'ArrowDown') && messageInput.value !== '' && !isAtFirstLineStart(messageInput)) return false;
					if (e.key === 'ArrowDown' && messageHistoryIndex === -1) return false;

					messageHistoryEntries = loadMessageHistory();
					if (messageHistoryEntries.length === 0) return false;
					e.preventDefault();

					if (e.key === 'ArrowUp') {
						if (messageHistoryIndex === -1) messageHistoryDraft = messageInput.value;
						if (messageHistoryIndex < messageHistoryEntries.length - 1) messageHistoryIndex++;
						setMessageInputFromHistory(messageHistoryEntries[messageHistoryEntries.length - 1 - messageHistoryIndex]);
						return true;
					}

					if (messageHistoryIndex > 0) {
						messageHistoryIndex--;
						setMessageInputFromHistory(messageHistoryEntries[messageHistoryEntries.length - 1 - messageHistoryIndex]);
					} else {
						setMessageInputFromHistory(messageHistoryDraft);
						resetMessageHistoryNavigation();
					}
					return true;
				}

				// Clear attachments function (registered on window for onclick handlers)
				window[clearFuncName] = function() {
					if (preview) preview.classList.add('hidden');
					if (listContainer) listContainer.innerHTML = '';
					if (sessionInput) sessionInput.value = '';
					if (fileInput) fileInput.value = '';
				};

			// Wire up the Clear All button
			if (clearBtn) {
				clearBtn.onclick = function() { window[clearFuncName](); };
			}

						// Keyboard submission and message history navigation
						if (messageInput) {
							messageInput.addEventListener('keydown', function(e) {
								if (handleMessageHistoryKeydown(e)) return;
								if (e.key === 'Enter' && !e.shiftKey) {
									e.preventDefault();
									safeSubmit();
								}
							});
							messageInput.addEventListener('input', function() {
								if (!suppressMessageHistoryInputReset) resetMessageHistoryNavigation();
							});
						}

					// Normalize send-button clicks to the same submit path as Enter.
						if (submitBtn) {
							submitBtn.addEventListener('click', function(e) {
								e.preventDefault();
								form.setAttribute('hx-post', normalPostEndpoint);
								safeSubmit();
							});
						}
			// Model selector -> hidden input sync + localStorage persistence
			var projectIdInput = form.querySelector('input[name="_project_id"]');
			var projectId = projectIdInput ? projectIdInput.value : '';
			var modelStorageKey = projectId ? 'chat-model-' + projectId : '';
			var modeStorageKey = projectId ? 'chat-mode-' + projectId : '';

			if (agentSelect && agentInput) {
				// Restore persisted selection
				if (modelStorageKey) {
					var saved = localStorage.getItem(modelStorageKey);
					if (saved) {
						// Verify the saved option still exists in the dropdown
						var optExists = Array.from(agentSelect.options).some(function(opt) { return opt.value === saved; });
						if (optExists) {
							agentSelect.value = saved;
							agentInput.value = saved;
						} else {
							localStorage.removeItem(modelStorageKey);
						}
					}
				}
				agentSelect.addEventListener('change', function() {
					agentInput.value = this.value;
					if (modelStorageKey) {
						localStorage.setItem(modelStorageKey, this.value);
					}
				});
			}

			// Chat mode selector -> hidden input sync + localStorage persistence
			if (modeSelect && modeInput) {
				function reevaluatePlanPrompt() {
					setTimeout(function() {
						if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
					}, 0);
				}
				// Mark selector as not hydrated until default + persisted restore is applied.
				modeSelect.dataset.hydrated = 'false';
				// Ensure UI reflects current hidden default first
				if (modeInput.value) {
					modeSelect.value = modeInput.value;
				}

				// Restore persisted selection
				if (modeStorageKey) {
					var savedMode = localStorage.getItem(modeStorageKey);
					if (savedMode) {
						var modeExists = Array.from(modeSelect.options).some(function(opt) { return opt.value === savedMode; });
						if (modeExists) {
							modeSelect.value = savedMode;
							modeInput.value = savedMode;
							reevaluatePlanPrompt();
						} else {
							localStorage.removeItem(modeStorageKey);
						}
					}
				}
				modeSelect.dataset.hydrated = 'true';

				modeSelect.addEventListener('change', function() {
					modeInput.value = this.value;
					if (modeStorageKey) {
						localStorage.setItem(modeStorageKey, this.value);
					}
					modeSelect.dataset.hydrated = 'true';
					reevaluatePlanPrompt();
				});
			}

			function formatBytes(bytes) {
				if (bytes < 1024) return bytes + ' B';
				var k = 1024;
				var sizes = ['KB', 'MB', 'GB'];
				var i = Math.floor(Math.log(bytes) / Math.log(k));
				return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i - 1];
			}

			async function handleFiles(files) {
				if (files.length === 0) return;
				if (files.length > 3) {
					alert('Maximum 3 files allowed');
					return;
				}
				var maxSize = 10 * 1024 * 1024;
				for (var j = 0; j < files.length; j++) {
					if (files[j].size > maxSize) {
						alert('File "' + files[j].name + '" exceeds 10MB limit');
						return;
					}
				}
				var formData = new FormData();
				files.forEach(function(file) { formData.append('files', file); });
				try {
					var response = await fetch('/chat/attachments', {
						method: 'POST',
						body: formData
					});
					if (!response.ok) {
						var error = await response.text();
						alert('Upload failed: ' + error);
						return;
					}
					var result = await response.json();
					sessionInput.value = result.session_id;
					preview.classList.remove('hidden');
					listContainer.innerHTML = '';
					result.attachments.forEach(function(att) {
						var div = document.createElement('div');
						div.className = 'flex items-center gap-2 text-sm';
						div.innerHTML = '<svg class="w-4 h-4 text-base-content/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg><span class="font-medium">' + att.filename + '</span><span class="text-xs opacity-60">' + formatBytes(att.size) + '</span>';
						listContainer.appendChild(div);
					});
					// Auto-scroll to show the attachment preview after upload
					requestAnimationFrame(function() {
						// Find the chat messages container (works for both /chat and task thread)
						var chatMessages = document.getElementById('chat-messages') || document.getElementById('task-thread-messages');
						if (chatMessages && window.chatAutoScroll) {
							window.chatAutoScroll.scrollToBottom(chatMessages, true);
						}
					});
				} catch (error) {
					console.error('Upload error:', error);
					alert('Upload failed: ' + error.message);
				}
			}

			// File input handler
			if (fileInput) {
				fileInput.addEventListener('change', function(e) {
					handleFiles(Array.from(e.target.files));
					e.target.value = '';
				});
			}

			// Drag-and-drop
			var dragCounter = 0;
			form.addEventListener('dragenter', function(e) {
				e.preventDefault();
				e.stopPropagation();
				dragCounter++;
				if (dropOverlay) dropOverlay.classList.remove('hidden');
			});
			form.addEventListener('dragover', function(e) {
				e.preventDefault();
				e.stopPropagation();
			});
			form.addEventListener('dragleave', function(e) {
				e.preventDefault();
				e.stopPropagation();
				dragCounter--;
				if (dragCounter <= 0) {
					dragCounter = 0;
					if (dropOverlay) dropOverlay.classList.add('hidden');
				}
			});
			form.addEventListener('drop', function(e) {
				e.preventDefault();
				e.stopPropagation();
				dragCounter = 0;
				if (dropOverlay) dropOverlay.classList.add('hidden');
				var files = Array.from(e.dataTransfer.files);
				if (files.length > 0) handleFiles(files);
			});

			// Speech-to-text via Web Speech API with audio level detection
			(function() {
				var micBtn = form.querySelector('.stt-btn');
				if (!micBtn || !messageInput) return;

				var micIcon = micBtn.querySelector('.stt-mic-icon');
				var stopIcon = micBtn.querySelector('.stt-stop-icon');
				var recognition = null;
				var isRecording = false;
				var manualStop = false;

				// Audio analysis for silence detection
				var audioContext = null;
				var audioAnalyzer = null;
				var audioStream = null;
				var silenceTimer = null;
				var silenceThreshold = 2000; // 2 seconds like Chrome plugin
				var audioLevel = 0;
				var countdownInterval = null;
				var countdownSeconds = 0;

				// Speech transcription state
				var finalTranscript = '';
				var startPos = 0;
				var existingText = '';
				var initialValue = '';
				var prefix = '';
				var suffix = '';

				// Check browser support
				var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
				if (!SpeechRecognition) {
					micBtn.title = 'Speech-to-text not supported in this browser';
					micBtn.classList.add('opacity-20', 'cursor-not-allowed');
					micBtn.classList.remove('hover:opacity-100', 'hover:bg-base-300');
					micBtn.setAttribute('aria-label', 'Speech-to-text not supported');
					micBtn.onclick = function() {
						alert('Speech-to-text is not supported in this browser. Please use Chrome, Edge, or Safari.');
					};
					return;
				}

				function startRecording() {
					recognition = new SpeechRecognition();
					recognition.continuous = true;
					recognition.interimResults = true;
					recognition.lang = navigator.language || 'en-US';

					finalTranscript = '';
					startPos = messageInput.selectionStart || messageInput.value.length;
					existingText = messageInput.value;
					initialValue = messageInput.value;
					manualStop = false;

					// Insert at cursor position or append
					prefix = existingText.substring(0, startPos);
					suffix = existingText.substring(startPos);
					if (prefix.length > 0 && !prefix.endsWith(' ') && !prefix.endsWith('\n')) {
						prefix += ' ';
					}

					recognition.onstart = function() {
						console.log('[STT] Recognition started');
						// Start audio analysis for silence detection
						startAudioAnalysis();
					};

					recognition.onresult = function(event) {
						var interimTranscript = '';
						for (var i = event.resultIndex; i < event.results.length; i++) {
							var transcript = event.results[i][0].transcript;
							if (event.results[i].isFinal) {
								finalTranscript += transcript + ' ';
							} else {
								interimTranscript += transcript;
							}
						}
						// Show interim + final results in the textarea
						messageInput.value = prefix + finalTranscript + interimTranscript + suffix;
						// Trigger input event for draft persistence
						messageInput.dispatchEvent(new Event('input', { bubbles: true }));
					};

					recognition.onerror = function(event) {
						if (event.error === 'not-allowed') {
							alert('Microphone access was denied. Please allow microphone access in your browser settings.');
						} else if (event.error === 'no-speech') {
							// Silence detected - this is normal, don't alert
						} else if (event.error !== 'aborted') {
							console.error('Speech recognition error:', event.error);
						}
						stopListening();
					};

					recognition.onend = function() {
						console.log('[STT] Recognition ended, manualStop=' + manualStop);
						// If continuous mode, restart unless manually stopped
						if (isRecording && !manualStop) {
							try {
								recognition.start();
							} catch (e) {
								console.error('[STT] Failed to restart recognition:', e);
								stopListening();
							}
						}
					};

					try {
						recognition.start();
						isRecording = true;
						micBtn.classList.add('stt-recording');
						micBtn.classList.remove('opacity-50');
						micBtn.setAttribute('aria-label', 'Stop recording');
						micBtn.title = 'Stop recording';
						if (micIcon) micIcon.classList.add('hidden');
						if (stopIcon) stopIcon.classList.remove('hidden');
					} catch (err) {
						console.error('Failed to start speech recognition:', err);
						alert('Failed to start speech recognition. Please try again.');
					}
				}

				function startAudioAnalysis() {
					if (audioContext) return;

					navigator.mediaDevices.getUserMedia({ audio: true })
						.then(function(stream) {
							audioStream = stream;
							audioContext = new (window.AudioContext || window.webkitAudioContext)();
							audioAnalyzer = audioContext.createAnalyser();
							audioAnalyzer.fftSize = 2048;

							var source = audioContext.createMediaStreamSource(stream);
							source.connect(audioAnalyzer);

							// Start monitoring audio levels
							monitorAudioLevel();
						})
						.catch(function(err) {
							console.error('[STT] Failed to start audio analysis:', err);
							// Don't stop voice recognition if audio analysis fails
						});
				}

				function monitorAudioLevel() {
					if (!audioAnalyzer || !isRecording) return;

					var bufferLength = audioAnalyzer.frequencyBinCount;
					var dataArray = new Uint8Array(bufferLength);

					var checkLevel = function() {
						if (!isRecording || !audioAnalyzer) return;

						audioAnalyzer.getByteFrequencyData(dataArray);

						// Calculate average volume
						var sum = dataArray.reduce(function(a, b) { return a + b; }, 0);
						audioLevel = sum / bufferLength;

						// Silence threshold: if volume is below 10 (very quiet)
						var isSilent = audioLevel < 10;

						if (isSilent) {
							// Start or continue silence timer
							if (!silenceTimer) {
								startSilenceTimer();
							}
						} else {
							// Reset silence timer if user is speaking
							clearSilenceTimer();
							clearCountdown();
						}

						// Continue monitoring
						requestAnimationFrame(checkLevel);
					};

					checkLevel();
				}

				function startSilenceTimer() {
					if (silenceTimer) return;

					console.log('[STT] Silence detected, starting timer...');

					// Start countdown visual feedback
					countdownSeconds = Math.ceil(silenceThreshold / 1000);
					startCountdown();

					silenceTimer = setTimeout(function() {
						console.log('[STT] Silence threshold reached, auto-submitting...');
						autoSubmitVoiceFeedback();
					}, silenceThreshold);
				}

				function clearSilenceTimer() {
					if (silenceTimer) {
						clearTimeout(silenceTimer);
						silenceTimer = null;
					}
				}

				function startCountdown() {
					clearCountdown();

					updateCountdownDisplay();

					countdownInterval = setInterval(function() {
						countdownSeconds--;
						if (countdownSeconds <= 0) {
							clearCountdown();
						} else {
							updateCountdownDisplay();
						}
					}, 1000);
				}

				function updateCountdownDisplay() {
					if (countdownSeconds > 0) {
						micBtn.title = 'Auto-send in ' + countdownSeconds + 's...';
					} else {
						micBtn.title = 'Recording...';
					}
				}

				function clearCountdown() {
					if (countdownInterval) {
						clearInterval(countdownInterval);
						countdownInterval = null;
					}
					countdownSeconds = 0;
					if (isRecording) {
						micBtn.title = 'Recording...';
					}
				}

				function stopAudioAnalysis() {
					if (audioContext) {
						audioContext.close();
						audioContext = null;
					}
					if (audioStream) {
						audioStream.getTracks().forEach(function(track) { track.stop(); });
						audioStream = null;
					}
					audioAnalyzer = null;
					audioLevel = 0;
				}

				function autoSubmitVoiceFeedback() {
					// Stop listening first
					stopListening();

					// Wait a moment for final transcript to be processed
					setTimeout(function() {
						// Submit the feedback if there's text
							if (messageInput.value.trim()) {
								safeSubmit();
							}					}, 500);
				}

				function stopListening() {
					isRecording = false;
					clearSilenceTimer();
					clearCountdown();
					stopAudioAnalysis();

					if (recognition) {
						try { recognition.stop(); } catch (e) { /* ignore */ }
						recognition = null;
					}

					micBtn.classList.remove('stt-recording');
					micBtn.classList.add('opacity-50');
					micBtn.setAttribute('aria-label', 'Start speech to text');
					micBtn.title = 'Speech to text';
					if (micIcon) micIcon.classList.remove('hidden');
					if (stopIcon) stopIcon.classList.add('hidden');
				}

				micBtn.addEventListener('click', function(e) {
					e.preventDefault();
					if (isRecording) {
						manualStop = true;
						stopListening();
					} else {
						startRecording();
					}
				});

				// Stop recording on form submit
				form.addEventListener('submit', function() {
					if (isRecording) {
						manualStop = true;
						stopListening();
					}
				});
			})();

					// Clear input and attachments after successful composer submission.
					// Ignore bubbled HTMX events from nested composer controls such as queued-input actions.
					form.addEventListener('htmx:beforeRequest', function(event) {
						if (!event.detail || event.detail.elt !== form) return;
						form.setAttribute('hx-post', normalPostEndpoint);
						messageHistorySubmittedValue = messageInput ? messageInput.value : '';
					});

					form.addEventListener('htmx:afterRequest', function(event) {
						if (!event.detail || event.detail.elt !== form) return;
						if (event.detail.successful) {
							var xhr = event.detail.xhr;
							var responseText = xhr ? (xhr.responseText || '') : '';
							// Keep user draft intact when the handler intentionally returns no content
							// (e.g. model-setup guard toasts) so users don't lose their message.
							if (responseText.trim() !== '') {
								rememberSubmittedMessage(messageHistorySubmittedValue);
								resetMessageHistoryNavigation();
								if (messageInput) messageInput.value = '';
								if (window[clearFuncName]) window[clearFuncName]();
							}
						}
						messageHistorySubmittedValue = '';
					});		})();
	</script>
}

// ChatAutoScrollScript emits the shared auto-scroll utility and marker cleaning JS.
// Should be included once per page that uses chat components.
templ ChatAutoScrollScript() {
	<script>
		// Shared auto-scroll utility
		window.chatAutoScroll = {
			isNearBottom: function(element) {
				if (!element) return false;
				var threshold = 100;
				return element.scrollHeight - element.scrollTop - element.clientHeight <= threshold;
			},
			scrollToBottom: function(element, smooth) {
				if (!element) return;
				element.scrollTo({
					top: element.scrollHeight,
					behavior: smooth ? 'smooth' : 'auto'
				});
			},
			autoScrollIfNearBottom: function(element) {
				if (this.isNearBottom(element)) {
					this.scrollToBottom(element, true);
				}
			}
		};
		// Alias for backward compatibility (task thread used a separate namespace)
		window.threadAutoScroll = window.chatAutoScroll;

		// ChatScrollTracker tracks whether the user has scrolled away from the bottom
		// using REAL user-interaction signals (wheel/touchmove/keydown/pointerdown).
		// This is critical for very large conversations during streaming because:
		//   - renderStreamingContent() does `container.innerHTML = ''` on every chunk.
		//     That temporarily shrinks scrollHeight; the browser clamps scrollTop and
		//     fires a scroll event. A naive "userScrolledUp = !isNearBottom" handler
		//     would interpret the clamp as the user being at the bottom and clear the
		//     scrolled-up flag, undoing the user's scroll-up on every chunk.
		//   - We must only clear userScrolledUp when the user themselves scrolls back
		//     to the bottom. Programmatic / clamp scrolls must not clear the flag.
		//
		// Implementation:
		//   - Interaction signals (wheel, touchmove, keydown of nav keys) mark a
		//     short-lived _userInteracting=true window (250ms).
		//   - Pointer/scrollbar drags stay active from pointerdown until
		//     pointerup/pointercancel/window blur so long scrollbar drags in huge
		//     conversations don't expire mid-drag.
		//   - scroll handler:
		//       user interaction + away from bottom    -> userScrolledUp = true
		//       user interaction + back at bottom      -> userScrolledUp = false
		//       not interacting                        -> preserve flag (don't trust)
		//   - shouldAutoScroll() returns !userScrolledUp. Do NOT AND with
		//     isNearBottom — during innerHTML refresh that creates a clamp-driven
		//     "yes auto-scroll" pulse that yanks the user back down.
		window.ChatScrollTracker = function(element) {
			this.element = element;
			this.userScrolledUp = false;
			this._userInteracting = false;
			this._pointerInteracting = false;
			this._userInteractTimeout = null;
			this._handlers = {};
			this._init();
		};

		window.ChatScrollTracker.prototype = {
			_init: function() {
				var self = this;
				if (!this.element) return;

				function markInteracting() {
					self._userInteracting = true;
					if (self._userInteractTimeout) clearTimeout(self._userInteractTimeout);
					self._userInteractTimeout = setTimeout(function() {
						if (!self._pointerInteracting) self._userInteracting = false;
					}, 250);
				}

				function endPointerInteraction() {
					self._pointerInteracting = false;
					if (self._userInteractTimeout) clearTimeout(self._userInteractTimeout);
					self._userInteractTimeout = setTimeout(function() {
						self._userInteracting = false;
					}, 250);
				}

				this._handlers.wheel = function() { markInteracting(); };
				this._handlers.touchmove = function() { markInteracting(); };
				this._handlers.pointerdown = function() {
					self._pointerInteracting = true;
					markInteracting();
				};
				this._handlers.pointerup = endPointerInteraction;
				this._handlers.pointercancel = endPointerInteraction;
				this._handlers.blur = endPointerInteraction;
				this._handlers.keydown = function(e) {
					// Treat scroll-navigation keys as user scroll intent.
					// Only count when focus is inside the scroll container or on body
					// (avoids triggering on textarea typing — typing doesn't scroll).
					var k = e.key;
					if (k === 'PageUp' || k === 'PageDown' || k === 'Home' || k === 'End' ||
						k === 'ArrowUp' || k === 'ArrowDown' || k === ' ' || k === 'Spacebar') {
						var t = e.target;
						if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
						markInteracting();
					}
				};

				this._handlers.scroll = function() {
					if (!self.element) return;
					var isNear = window.chatAutoScroll.isNearBottom(self.element);
					if (self._userInteracting) {
						self.userScrolledUp = !isNear;
					}
					// Programmatic / clamp scrolls: PRESERVE the flag. Do not clear it
					// just because the viewport happens to be near the bottom after a
					// DOM refresh — that would defeat user scroll-up during streaming.
				};

				this.element.addEventListener('wheel', this._handlers.wheel, { passive: true });
				this.element.addEventListener('touchmove', this._handlers.touchmove, { passive: true });
				this.element.addEventListener('pointerdown', this._handlers.pointerdown, { passive: true });
				this.element.addEventListener('scroll', this._handlers.scroll, { passive: true });
				// keydown is attached to window so PageUp/PageDown work even when the
				// scroll container isn't focused. pointerup/cancel are also window-level
				// because scrollbar drags can end outside the scroll element.
				window.addEventListener('keydown', this._handlers.keydown, { passive: true });
				window.addEventListener('pointerup', this._handlers.pointerup, { passive: true });
				window.addEventListener('pointercancel', this._handlers.pointercancel, { passive: true });
				window.addEventListener('blur', this._handlers.blur);

				// Initial state based on current viewport position only — no interaction
				// signal yet, so we trust the static layout.
				this.userScrolledUp = !window.chatAutoScroll.isNearBottom(this.element);
			},

			// shouldAutoScroll: only the persisted flag governs auto-scroll. Once the
			// user scrolls up they stay parked there until they themselves scroll back.
			shouldAutoScroll: function() {
				if (!this.element) return true;
				return !this.userScrolledUp;
			},

			// Re-bind to a new element (e.g. after morph swap replaced #task-thread-messages
			// or #chat-messages). Without this the tracker would hold a detached element
			// whose scrollHeight is 0 -> isNearBottom is always true -> auto-scroll forever.
			rebind: function(newElement) {
				if (!newElement || newElement === this.element) {
					// Same element — but check if it's still attached. If detached, drop it.
					if (this.element && !this.element.isConnected) {
						this.destroy();
						this.element = newElement || null;
						if (this.element) this._init();
					}
					return;
				}
				var prevUserScrolledUp = this.userScrolledUp;
				this.destroy();
				this.element = newElement;
				this._init();
				// Preserve scroll intent across rebind so a morph swap doesn't reset
				// the user's scroll-up.
				this.userScrolledUp = prevUserScrolledUp;
			},

			resetOnUserSend: function() {
				this.userScrolledUp = false;
				this._userInteracting = false;
				this._pointerInteracting = false;
				if (this._userInteractTimeout) clearTimeout(this._userInteractTimeout);
				if (this.element) {
					window.chatAutoScroll.scrollToBottom(this.element, false);
				}
			},

			snapshot: function() {
				if (!this.element) return { scrollTop: 0, userScrolledUp: false, pinned: true };
				var nearBottom = window.chatAutoScroll.isNearBottom(this.element);
				return {
					scrollTop: this.element.scrollTop || 0,
					userScrolledUp: this.userScrolledUp || !nearBottom,
					pinned: !this.userScrolledUp && nearBottom
				};
			},

			autoScroll: function() {
				if (this.shouldAutoScroll() && this.element) {
					window.chatAutoScroll.scrollToBottom(this.element, true);
				}
			},

			destroy: function() {
				if (this._userInteractTimeout) clearTimeout(this._userInteractTimeout);
				this._userInteractTimeout = null;
				this._userInteracting = false;
				this._pointerInteracting = false;
				if (this._handlers.keydown) window.removeEventListener('keydown', this._handlers.keydown);
				if (this._handlers.pointerup) window.removeEventListener('pointerup', this._handlers.pointerup);
				if (this._handlers.pointercancel) window.removeEventListener('pointercancel', this._handlers.pointercancel);
				if (this._handlers.blur) window.removeEventListener('blur', this._handlers.blur);
				if (!this.element) return;
				if (this._handlers.scroll) this.element.removeEventListener('scroll', this._handlers.scroll);
				if (this._handlers.wheel) this.element.removeEventListener('wheel', this._handlers.wheel);
				if (this._handlers.touchmove) this.element.removeEventListener('touchmove', this._handlers.touchmove);
				if (this._handlers.pointerdown) this.element.removeEventListener('pointerdown', this._handlers.pointerdown);
			}
		};

		window.initChatEarlierLoader = function(containerOrID) {
			var container = typeof containerOrID === 'string' ? document.getElementById(containerOrID) : containerOrID;
			if (!container) return;
			if (container.dataset.earlierLoaderBound === 'true') return;
			container.dataset.earlierLoaderBound = 'true';

			function setEarlierLoaderBusy(loader, busy) {
				if (!loader) return;
				loader.dataset.loading = busy ? 'true' : 'false';
				var idle = loader.querySelector('[data-earlier-loader-idle]');
				var busyEl = loader.querySelector('[data-earlier-loader-busy]');
				if (idle) idle.classList.toggle('hidden', busy);
				if (busyEl) busyEl.classList.toggle('hidden', !busy);
			}

			function recoverIdleEarlierRequest() {
				if (container.dataset.earlierRequestLoading !== 'true') return true;
				var busyLoader = container.querySelector('[data-earlier-loader="true"][data-loading="true"]');
				if (busyLoader) return false;
				container.dataset.earlierRequestLoading = 'false';
				return true;
			}

			function resetGestureForNewUserIntent() {
				if (!recoverIdleEarlierRequest()) return false;
				container.dataset.earlierGestureLocked = 'false';
				return true;
			}

			function maybeLoadEarlier() {
				var loader = container.querySelector('[data-earlier-loader="true"]');
				if (!loader || loader.dataset.loading === 'true') return;
				if (container.dataset.earlierRequestLoading === 'true') return;
				if (container.dataset.earlierGestureLocked === 'true') return;
				if (container.scrollTop > 12) return;
				container.dataset.earlierGestureLocked = 'true';
				container.dataset.earlierRequestLoading = 'true';
				if (window.prepareChatEarlierSwap) window.prepareChatEarlierSwap(loader);
				setEarlierLoaderBusy(loader, true);
				loader.dispatchEvent(new CustomEvent('ov:load-earlier', { bubbles: true }));
			}

			container.addEventListener('scroll', function() {
				if (container.dataset.earlierAnchorRestoring === 'true') return;
				if (container.scrollTop > 12) {
					resetGestureForNewUserIntent();
					return;
				}
				maybeLoadEarlier();
			}, { passive: true });
			container.addEventListener('wheel', function(event) {
				if (event.deltaY < 0) {
					var now = Date.now();
					var lastWheelAt = parseInt(container.dataset.earlierLastWheelAt || '0', 10) || 0;
					container.dataset.earlierLastWheelAt = String(now);
					if (now - lastWheelAt > 500 && !resetGestureForNewUserIntent()) return;
					maybeLoadEarlier();
				}
			}, { passive: true });
			container.addEventListener('touchstart', function(event) {
				if (event.touches && event.touches.length > 0) {
					container.dataset.earlierTouchY = String(event.touches[0].clientY);
					resetGestureForNewUserIntent();
				}
			}, { passive: true });
			container.addEventListener('touchmove', function(event) {
				var startY = parseFloat(container.dataset.earlierTouchY || '0') || 0;
				if (event.touches && event.touches.length > 0 && event.touches[0].clientY > startY + 4) {
					maybeLoadEarlier();
				}
			}, { passive: true });
				if (window.bindChatEarlierKeyboardLoader) window.bindChatEarlierKeyboardLoader();
				if (window.bindChatEarlierHTMXLifecycle) window.bindChatEarlierHTMXLifecycle();
			};
			window.bindChatEarlierKeyboardLoader = function() {
				if (window._chatEarlierKeyboardLoaderBound) return;
				window._chatEarlierKeyboardLoaderBound = true;
				document.addEventListener('keydown', function(event) {
					if (!['ArrowUp', 'PageUp', 'Home'].includes(event.key)) return;
					if (event.repeat) return;
					document.querySelectorAll('#chat-messages, #task-thread-messages').forEach(function(container) {
						if (container.dataset.earlierLoaderBound !== 'true' || container.scrollTop > 12) return;
						if (container.dataset.earlierRequestLoading === 'true' && container.querySelector('[data-earlier-loader="true"][data-loading="true"]')) return;
						container.dataset.earlierRequestLoading = 'false';
						container.dataset.earlierGestureLocked = 'false';
						var loader = container.querySelector('[data-earlier-loader="true"]');
						if (!loader || loader.dataset.loading === 'true') return;
						if (container.dataset.earlierGestureLocked === 'true') return;
						container.dataset.earlierGestureLocked = 'true';
						container.dataset.earlierRequestLoading = 'true';
						if (window.prepareChatEarlierSwap) window.prepareChatEarlierSwap(loader);
						loader.dataset.loading = 'true';
						var idle = loader.querySelector('[data-earlier-loader-idle]');
						var busyEl = loader.querySelector('[data-earlier-loader-busy]');
						if (idle) idle.classList.add('hidden');
						if (busyEl) busyEl.classList.remove('hidden');
						loader.dispatchEvent(new CustomEvent('ov:load-earlier', { bubbles: true }));
					});
				});
			};
			function getEarlierContainerForElement(element) {
				if (!element || !element.getAttribute) return null;
				var containerID = element.getAttribute('data-container-id') || '';
				var container = containerID ? document.getElementById(containerID) : null;
				if (!container && element.closest) container = element.closest('#chat-messages, #task-thread-messages');
				return container;
			}

			function getFirstVisibleExecutionPair(container) {
				var pairs = Array.prototype.slice.call(container.querySelectorAll(':scope > [data-execution-pair="true"]'));
				var containerTop = container.getBoundingClientRect().top;
				var containerBottom = container.getBoundingClientRect().bottom;
				for (var i = 0; i < pairs.length; i++) {
					var rect = pairs[i].getBoundingClientRect();
					if (rect.bottom > containerTop + 1 && rect.top < containerBottom - 1) return { pair: pairs[i], offset: rect.top - containerTop };
				}
				return null;
			}

			window.prepareChatEarlierSwap = function(loader) {
				var container = getEarlierContainerForElement(loader);
				if (!container || container.dataset.earlierSwapPrepared === 'true') return;
				container.dataset.earlierSwapPrepared = 'true';
				container.dataset.earlierPrevScrollHeight = String(container.scrollHeight || 0);
				container.dataset.earlierPrevScrollTop = String(container.scrollTop || 0);
				container.dataset.earlierPrevBottomDistance = String((container.scrollHeight || 0) - (container.scrollTop || 0));
				var anchor = getFirstVisibleExecutionPair(container);
				if (anchor && anchor.pair) {
					container.dataset.earlierAnchorExecId = anchor.pair.getAttribute('data-exec-id') || '';
					container.dataset.earlierAnchorOffsetTop = String(anchor.offset || 0);
				} else {
					delete container.dataset.earlierAnchorExecId;
					delete container.dataset.earlierAnchorOffsetTop;
				}
			};

			function setAllEarlierLoadersIdle(container) {
				container.querySelectorAll('[data-earlier-loader="true"]').forEach(function(loader) {
					loader.dataset.loading = 'false';
					var idle = loader.querySelector('[data-earlier-loader-idle]');
					var busyEl = loader.querySelector('[data-earlier-loader-busy]');
					if (idle) idle.classList.remove('hidden');
					if (busyEl) busyEl.classList.add('hidden');
				});
			}

			window.finishChatEarlierRequest = function(swapped) {
				var container = getEarlierContainerForElement(swapped);
				if (!container) return;
				container.dataset.earlierRequestLoading = 'false';
				delete container.dataset.earlierSwapPrepared;
				setAllEarlierLoadersIdle(container);
			};

			window.afterChatEarlierSwap = function(swapped) {
				var container = getEarlierContainerForElement(swapped);
				if (!container) return;
				setAllEarlierLoadersIdle(container);
				if (window.htmx) htmx.process(container);
				if (window.cleanAssistantMessages) window.cleanAssistantMessages(container);
				if (window.applyChatBubbleTransforms) window.applyChatBubbleTransforms(container);
				if (window._initThreadStreaming) window._initThreadStreaming();
			};

			window.bindChatEarlierHTMXLifecycle = function() {
				if (window._chatEarlierHTMXLifecycleBound) return;
				window._chatEarlierHTMXLifecycleBound = true;
				document.body.addEventListener('htmx:beforeRequest', function(event) {
					var loader = event.detail && event.detail.elt;
					if (!loader || !loader.matches || !loader.matches('[data-earlier-loader="true"]')) return;
					if (window.prepareChatEarlierSwap) window.prepareChatEarlierSwap(loader);
				});
				document.body.addEventListener('htmx:afterSwap', function(event) {
					var loader = event.detail && event.detail.elt;
					if (!loader || !loader.matches || !loader.matches('[data-earlier-loader="true"]')) return;
					if (window.afterChatEarlierSwap) window.afterChatEarlierSwap(loader);
				});
				document.body.addEventListener('htmx:afterSettle', function(event) {
					var loader = event.detail && event.detail.elt;
					if (!loader || !loader.matches || !loader.matches('[data-earlier-loader="true"]')) return;
					var container = getEarlierContainerForElement(loader);
					if (window.restoreChatEarlierScroll) window.restoreChatEarlierScroll(container);
				});
			};

			window.restoreChatEarlierScroll = function(container) {
				if (!container) return;
				var prevHeight = parseInt(container.dataset.earlierPrevScrollHeight || '0', 10) || 0;
				var prevTop = parseInt(container.dataset.earlierPrevScrollTop || '0', 10) || 0;
				var prevBottomDistance = parseInt(container.dataset.earlierPrevBottomDistance || '0', 10) || 0;
				var anchorExecID = container.dataset.earlierAnchorExecId || '';
				var anchorOffsetTop = parseFloat(container.dataset.earlierAnchorOffsetTop || '0') || 0;
				if (prevHeight <= 0) {
					container.dataset.earlierRequestLoading = 'false';
					delete container.dataset.earlierSwapPrepared;
					return;
				}
				container.dataset.earlierAnchorRestoring = 'true';
				requestAnimationFrame(function() {
					var restored = false;
					if (prevBottomDistance > 0) {
						container.scrollTop = Math.max(0, (container.scrollHeight || 0) - prevBottomDistance);
						restored = true;
					}
					if (!restored && anchorExecID) {
						var anchorPair = container.querySelector(':scope > [data-exec-id="' + anchorExecID.replace(/"/g, '\\"') + '"]');
						if (anchorPair) {
							var containerTop = container.getBoundingClientRect().top;
							var currentOffset = anchorPair.getBoundingClientRect().top - containerTop;
							container.scrollTop += currentOffset - anchorOffsetTop;
							restored = true;
						}
					}
					if (!restored) {
						container.scrollTop = prevTop + Math.max(0, (container.scrollHeight || 0) - prevHeight);
					}
					delete container.dataset.earlierPrevScrollHeight;
					delete container.dataset.earlierPrevScrollTop;
					delete container.dataset.earlierPrevBottomDistance;
					delete container.dataset.earlierAnchorExecId;
					delete container.dataset.earlierAnchorOffsetTop;
					delete container.dataset.earlierSwapPrepared;
					requestAnimationFrame(function() {
						container.dataset.earlierAnchorRestoring = 'false';
						container.dataset.earlierRequestLoading = 'false';
					});
				});
			};

			window.pruneChatExecutionWindow = function(containerOrID) {
				var container = typeof containerOrID === 'string' ? document.getElementById(containerOrID) : containerOrID;
				if (!container) return;
				var limit = parseInt(container.getAttribute('data-window-limit') || '0', 10) || 0;
				if (limit <= 0) return;
				var pairs = Array.prototype.slice.call(container.querySelectorAll(':scope > [data-execution-pair="true"]'));
				var pruned = false;
				while (pairs.length > limit) {
					var removed = pairs.shift();
					if (removed && removed.parentNode === container) {
						removed.remove();
						pruned = true;
					}
				}
				var first = container.querySelector(':scope > [data-execution-pair="true"]');
				var loader = container.querySelector('[data-earlier-loader="true"]');
				if (!loader && pruned && first) {
					var baseURL = container.getAttribute('data-earlier-url-base') || '';
					if (baseURL) {
						loader = document.createElement('div');
						loader.id = container.id + '-earlier-loader';
						loader.className = 'py-2 text-center text-xs opacity-60';
						loader.setAttribute('data-earlier-loader', 'true');
						loader.setAttribute('data-container-id', container.id);
						loader.setAttribute('data-window-limit', String(limit));
						loader.setAttribute('hx-get', baseURL);
						loader.setAttribute('hx-trigger', 'ov:load-earlier');
						loader.setAttribute('hx-target', '#' + container.id + '-earlier-loader');
						loader.setAttribute('hx-swap', 'outerHTML show:none');
						loader.setAttribute('hx-on::before-request', 'window.prepareChatEarlierSwap && window.prepareChatEarlierSwap(this)');
						loader.setAttribute('hx-on::after-swap', 'window.afterChatEarlierSwap && window.afterChatEarlierSwap(this)');
						loader.setAttribute('hx-on::after-request', 'if (event.detail && !event.detail.successful && window.finishChatEarlierRequest) window.finishChatEarlierRequest(this)');
						loader.innerHTML = '<span data-earlier-loader-idle>Scroll up to load earlier messages</span><span data-earlier-loader-busy class="hidden"><span class="loading loading-spinner loading-xs align-middle mr-2"></span>Loading earlier messages...</span>';
						container.insertBefore(loader, container.firstChild);
						if (window.htmx) htmx.process(loader);
					}
				}
				if (first && loader) {
					var execID = first.getAttribute('data-exec-id');
					var hxGet = loader.getAttribute('hx-get') || '';
					if (execID && hxGet) {
