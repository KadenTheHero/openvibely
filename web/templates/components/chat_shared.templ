			});

			// Preserve per-tool output scroll state across streaming re-renders.
			// The renderer rebuilds the container on each chunk, so each tool output
			// block must independently remember whether it was pinned to bottom.
			var prevToolBodyScrollStates = [];
			container.querySelectorAll('.stream-tool-body-scroll').forEach(function(el) {
				var scrollableY = el.getAttribute('data-scrollable-y') === 'true' || el.scrollHeight > el.clientHeight + 1;
				var pinned = !scrollableY || (el.scrollHeight - el.scrollTop - el.clientHeight) <= 2;
				prevToolBodyScrollStates.push({ scrollTop: el.scrollTop || 0, pinned: pinned, scrollableY: scrollableY });
			});
